#!/usr/bin/env python3

"""Convert Markdown into LaTeX Beamer slides.

A lightweight alternative to `pandoc -t beamer', built on marko.  The guiding
principle is LaTeX passthrough: whatever the Markdown parser does not
recognize is handed over to LaTeX untouched, so a slide can always fall back
to raw LaTeX.

The Beamer preamble lives in an external template file (see --template).
"""

import argparse
import marko
import marko.block
import marko.helpers
import marko.inline
import os
import re
import string
import sys
import yaml

PROG = 'mdslides'
VERSION = '0.1'

DEFAULT_TEMPLATE = 'beamer.tex.tpl'
TEMPLATE_ENV_VAR = 'MD_SLIDES_TEMPLATE'

# string.Template has no conditionals, so a variable the template mentions
# must always resolve to something: an unsubstituted '$theme' would reach
# LaTeX and be read as maths.  These are the values used when the metadata
# block says nothing.  'default' is a real Beamer theme name in all three
# cases, so the fallbacks produce a plain but valid presentation.
TEMPLATE_DEFAULTS = {
    'theme': 'default',
    'colortheme': 'default',
    'fonttheme': 'default',
    # what the template used to hard-code, so that a deck which says nothing
    # about fonts still looks the way it did
    'fontfamily': 'palatino',
    'title': '',
    'author': '',
    'institute': '',
    'date': '',
    'headerincludes': '',
    'titlepage': '',
}

# Metadata that is a list of people or places, rather than a block of text.
JOINED_WITH_AND = ('author', 'institute')

# Short forms for the footline; each falls back to its long form.
SHORT_FORMS = (('shorttitle', 'title'),
               ('shortauthor', 'author'),
               ('shortdate', 'date'),
               # beamer's footline is cramped, and the full affiliation
               # rarely fits, so this one defaults to empty instead
               ('shortinstitute', None))

# Characters that have to be escaped where LaTeX is not wanted, i.e. inside
# `inline code'.  Prose is passed through untouched; see BeamerRenderer.
LATEX_ESCAPES = {
    '\\': '\\textbackslash{}', '{': '\\{', '}': '\\}', '$': '\\$',
    '&': '\\&', '#': '\\#', '_': '\\_', '%': '\\%',
    '~': '\\~{}', '^': '\\^{}',
}

# '\_' in Markdown means a literal underscore, which LaTeX also spells '\_';
# '\*' on the other hand is just an asterisk.
LATEX_SPECIALS = set('#$%&_{}')

# Classes recognized in a frame's attribute list, '# Title {.fragile}'.
FRAME_OPTIONS = ('fragile', 'plain', 'allowframebreaks', 'shrink', 'squeeze',
                 'noframenumbering', 't', 'b', 'c')

# A trailing attribute list on a heading: '{.fragile}', '{label=intro}'.  The
# tokens have to look like attributes, so that a title ending in \hlbl{Foo}
# is not mistaken for one.
HEADING_ATTRS_RE = re.compile(
    r'\s*\{((?:\s*[.#][-\w]+|\s*[-\w]+=[^{}\s]+)+)\s*\}\s*$')

# Fence languages that mean "this is listings input, not a language": the
# body is handed to lstlisting as it stands, with escapechar switched on so
# that '@$x_1$@' typesets as maths instead of printing as itself.  Only
# these fences get it, since a C snippet is free to contain an '@'.
RAW_LISTING_LANGUAGES = ('lstlisting', 'listings')
LISTINGS_ESCAPECHAR = '@'

# Fence languages that the listings package knows.  It errors out on a
# language it cannot load, so anything missing here becomes a plain listing.
# A '[dialect]language' value has to reach LaTeX inside braces, and some
# languages (Lua) have dialects but no default, so naming one is mandatory.
# Every value below was checked by compiling it.
LISTINGS_LANGUAGES = {
    'c': 'C', 'c++': 'C++', 'cpp': 'C++', 'haskell': 'Haskell',
    'hs': 'Haskell', 'java': 'Java', 'python': 'Python', 'py': 'Python',
    'bash': 'bash', 'sh': 'sh', 'shell': 'sh', 'sql': 'SQL', 'tex': 'TeX',
    'latex': '[LaTeX]TeX', 'lua': '[5.3]Lua', 'perl': 'Perl', 'php': 'PHP',
    'ruby': 'Ruby', 'prolog': 'Prolog', 'lisp': 'Lisp', 'ml': 'ML',
    'caml': 'Caml', 'ocaml': '[Objective]Caml', 'r': 'R', 'matlab': 'Matlab',
    'xml': 'XML', 'html': 'HTML', 'make': 'make', 'makefile': 'make',
    'llvm': 'LLVM', 'verilog': 'Verilog', 'vhdl': 'VHDL',
    'fortran': 'Fortran', 'pascal': 'Pascal', 'ada': 'Ada',
}

# A fenced div, ':::' or more colons.  With an info string it opens one, on
# its own it closes one:  '::: { .column width=30% }' ... ':::'
DIV_FENCE_RE = re.compile(r'(:{3,})[ \t]*(.*?)[ \t]*$', re.MULTILINE)

# A code fence, so that a ':::' inside a listing is not mistaken for a div.
CODE_FENCE_RE = re.compile(r'[ \t]*(`{3,}|~{3,})')

# One item of an attribute list: '.class', '#identifier', 'key=value', or a
# bare word, which pandoc also treats as a class so that ':::  columns'
# works as shorthand for '::: {.columns}'.
ATTRIBUTE_RE = re.compile(r"""\s*(?:
      \.(?P<cls>[-\w:]+)
    | \#(?P<id>[-\w:]+)
    | (?P<key>[-\w:]+)[ \t]*=[ \t]*(?P<value>"[^"]*"|'[^']*'|[^\s}]+)
    | (?P<bare>[-\w:]+)
)""", re.VERBOSE)

# Alignment options accepted on \begin{columns}.
COLUMNS_OPTIONS = ('t', 'b', 'c', 'T', 'onlytextwidth')

# Div classes that map straight onto a Beamer environment taking a title.
TITLED_ENVIRONMENTS = ('block', 'alertblock', 'exampleblock')

# An image, with an optional title and an optional attribute list:
#   ![alt](figure.png "title"){ width=0.8 }
# Claimed whole, so that the attributes do not reach LaTeX as stray text.
IMAGE_RE = re.compile(r"""
    !\[(?P<alt>[^\]]*)\]
    \([ \t]*<?(?P<dest>[^)\s>]*)>?
    (?:[ \t]+(?P<quote>["'])(?P<title>.*?)(?P=quote))?
    [ \t]*\)
    (?:[ \t]*\{(?P<attrs>[^{}]*)\})?
""", re.VERBOSE)

# One item of an image's attribute list: 'width=0.8' or a bare flag.
IMAGE_ATTRIBUTE_RE = re.compile(r"""[ \t]*(?:
      (?P<key>[-\w]+)[ \t]*=[ \t]*(?P<value>"[^"]*"|'[^']*'|[^\s}]+)
    | (?P<flag>[-.#\w]+)
)""", re.VERBOSE)

# Keys measured against the slide, so a bare number is a fraction of it.
IMAGE_LENGTHS = {'width': 'textwidth', 'height': 'textheight'}

# An environment directive, '@column 0.3' ... '@end column'.  The contents
# are Markdown; write \begin{...} instead when they should be left alone.
DIRECTIVE_RE = re.compile(r'[ \t]{0,3}@(?P<name>[A-Za-z][-\w]*)(?P<args>.*)$',
                          re.MULTILINE)
DIRECTIVE_END_RE = re.compile(
    r'[ \t]{0,3}@end(?:[ \t]+(?P<name>[A-Za-z][-\w]*))?[ \t]*$', re.MULTILINE)

# A beamer overlay specification, '<2->', allowed in front of the arguments.
OVERLAY_RE = re.compile(r'(<[^>\n]*>)[ \t]*')

# An ATX heading, which closes any directive still open: a frame boundary is
# as far as an environment can reach.
HEADING_LINE_RE = re.compile(r'[ \t]{0,3}#{1,6}(?:[ \t]|$)')

# A bare number is a fraction of \textwidth, so '@column 0.3' is enough.
BARE_NUMBER_RE = re.compile(r'\d*\.?\d+$')

# Sugar, not semantics: an unlisted directive still works, you just write
# the brackets yourself.  A friendly argument becomes a width for these,
WIDTH_DIRECTIVES = frozenset(('column', 'minipage'))

# an optional [title] for these, since that is what theorem-likes take,
BRACKET_TITLE_DIRECTIVES = frozenset("""
    theorem lemma corollary definition example proof remark proposition
    claim fact observation conjecture
""".split())

# and a mandatory {title} for anything else, which is what block-likes want.

# Directives that are a command rather than an environment: '@note' becomes
# \note{...}, so Markdown can be written inside something beamer spells as a
# macro argument.
COMMAND_DIRECTIVES = frozenset(('note', 'alert', 'only', 'uncover', 'visible',
                                'invisible'))

# Directives where repeating the name closes the previous one instead of
# nesting inside it, so a row of columns needs no @end between them.
SIBLING_DIRECTIVES = frozenset(('column',))

# A LaTeX macro call: \name, \name*, \name[opt]{arg}, \name{a}{b}.  Regular
# expressions cannot count, so brace nesting is spelled out to three levels,
# which covers anything written by hand.
BRACED = r'\{(?:[^{}]|\{(?:[^{}]|\{[^{}]*\})*\})*\}'
MACRO = r'\\[A-Za-z@]+\*?(?:\[[^\]\n]*\])?(?:' + BRACED + r')*'

# A line holding nothing but macro calls, e.g. '\pausex' or '\medskip'.
MACRO_LINE_RE = re.compile(r'[ \t]*(?:' + MACRO + r'[ \t]*)+$', re.MULTILINE)

# The start of a LaTeX environment, '\begin{tabularx}'.
BEGIN_ENV_RE = re.compile(r'[ \t]*\\begin\{([A-Za-z@*]+)\}')

# Environments and macros that typeset their contents verbatim, so that a
# frame containing raw LaTeX still gets [fragile].
VERBATIM_RE = re.compile(r'\\begin\{(?:lstlisting|verbatim|Verbatim|alltt'
                         r'|minted|semiverbatim)\}|\\verb|\\lstinline')

# A YAML metadata block, fenced by '---' and closed by '---' or '...'.  Only
# recognized at the very start of the document, where CommonMark would
# otherwise see a thematic break.
FRONTMATTER_RE = re.compile(r"""\A---[ \t]*\r?\n              # opening fence
                                (.*?)                         # the YAML itself
                                ^(?:---|\.\.\.)[ \t]*\r?$\r?\n?  # closing fence
                             """, re.DOTALL | re.MULTILINE | re.VERBOSE)

# HTML comments are legal in Markdown but not in YAML, and they are a handy
# way to disable a metadata line, e.g. '<!--lang: en-->'.
YAML_COMMENT_RE = re.compile(r'^[ \t]*<!--.*?-->[ \t]*$\n?', re.MULTILINE)


###########################################
def find_template():
    """find_template() -> str

Returns the path to the default template: the one named by $MD_SLIDES_TEMPLATE
if set, otherwise the one shipped next to this script.
"""
    from_env = os.environ.get(TEMPLATE_ENV_VAR)
    if from_env:
        return from_env

    return os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        DEFAULT_TEMPLATE)


###########################################
def open_file(parser, path, mode, standard=None, what='file'):
    """open_file(ArgumentParser, str, str, file, str) -> file

Opens `path' in `mode', or returns `standard' if the path is '-'.  Files are
UTF-8 regardless of the locale, since a deck is likely to contain accented
characters.  A path that cannot be opened is a usage error, reported through
`parser', which exits with status 2.
"""
    if path == '-' and standard is not None:
        # Make sure a piped deck is decoded as UTF-8 too.  Under pytest the
        # standard streams are replaced by objects without reconfigure().
        if hasattr(standard, 'reconfigure'):
            standard.reconfigure(encoding='utf-8')
        return standard

    try:
        return open(path, mode, encoding='utf-8')
    except OSError as exc:
        parser.error("cannot open the %s '%s': %s"
                     % (what, path, exc.strerror))


###########################################
def split_frontmatter(text):
    """split_frontmatter(str) -> (dict, str)

Splits the leading YAML metadata block off `text' and returns the parsed
metadata together with the remaining Markdown body.  A document without a
metadata block yields an empty dict and the text unchanged.

The block is replaced by as many blank lines as it occupied, so that line
numbers in the body still match the input file.
"""
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}, text

    try:
        meta = yaml.safe_load(YAML_COMMENT_RE.sub('', match.group(1)))
    except yaml.YAMLError as exc:
        sys.exit("%s: cannot parse the metadata block: %s" % (PROG, exc))

    if meta is None:            # an empty metadata block
        meta = {}
    if not isinstance(meta, dict):
        sys.exit("%s: the metadata block must be a mapping, got %s"
                 % (PROG, type(meta).__name__))

    return meta, '\n' * match.group(0).count('\n') + text[match.end():]


###########################################
def as_list(value):
    """as_list(object) -> list

Wraps a lone metadata value in a list, so that 'author: X' and a YAML list of
authors can be handled the same way.
"""
    if value is None or value == '':
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    return [value]


def as_bool(value, default=False):
    """as_bool(object, bool) -> bool

Reads a metadata flag.  YAML gives us a real boolean, but -V on the command
line can only give a string, so 'false' and friends have to be understood
rather than taken as a non-empty and therefore true string.
"""
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() not in ('', 'false', 'no', 'off', '0')
    return bool(value)


###########################################
def build_variables(meta, slides):
    """build_variables(dict, str) -> dict

Turns the document metadata into the substitution mapping for the template.

Every variable the shipped template mentions is guaranteed to be present, so
that no '$name' can leak into the LaTeX output.  Metadata keys are passed
through as they are, which lets a custom template use anything from the
metadata block.
"""
    variables = dict(TEMPLATE_DEFAULTS)

    for key, value in meta.items():
        if value is None:               # e.g. a bare 'logo:' with no value
            continue
        if key in JOINED_WITH_AND:
            value = ' \\and '.join(str(item) for item in as_list(value))
        elif isinstance(value, (list, tuple)):
            value = '\n'.join(str(item) for item in value)
        variables[key] = value
        if '-' in key:
            # string.Template only recognizes identifiers, so
            # 'header-includes' has to be reachable as '$headerincludes'
            variables[key.replace('-', '')] = value

    # Options for \documentclass, as one string: an empty one would leave a
    # stray comma behind, which LaTeX complains about.
    options = ['dvipsnames']
    if meta.get('fontsize'):
        options.append(str(meta['fontsize']))
    if meta.get('aspectratio'):
        options.append('aspectratio=%s' % meta['aspectratio'])
    options.extend(str(option) for option in as_list(meta.get('classoption')))
    variables['classoptions'] = ','.join(options)

    for short, long in SHORT_FORMS:
        if not variables.get(short):
            variables[short] = variables[long] if long else ''

    # A title page, unless the deck has no title to put on one or asks not
    # to have it.  The template cannot decide this itself: string.Template
    # has no conditionals, so the choice is made here and the variable is
    # either the frame or nothing at all.
    if as_bool(meta.get('titlepage'), bool(variables['title'])):
        variables['titlepage'] = '\\frame{\\titlepage}'
    else:
        variables['titlepage'] = ''

    variables['slides'] = slides
    return variables


###########################################
def parse_image_attributes(text):
    """parse_image_attributes(str) -> (dict, [str])

Parses an image's attribute list into keyed values and bare flags:

    'width=0.8 clip'  ->  ({'width': '0.8'}, ['clip'])

Pandoc classes and identifiers ('.plain', '#fig') are accepted and
discarded: \\includegraphics has nowhere to put them.
"""
    values, flags = {}, []

    position = 0
    text = (text or '').strip()
    while position < len(text):
        match = IMAGE_ATTRIBUTE_RE.match(text, position)
        if not match or match.end() == position:
            break                           # not an attribute list after all
        position = match.end()
        if match.group('key'):
            values[match.group('key')] = match.group('value').strip('\'"')
        elif not match.group('flag').startswith(('.', '#')):
            flags.append(match.group('flag'))

    return values, flags


###########################################
def split_directive_arguments(arguments):
    """split_directive_arguments(str) -> (overlay, kind, text)

Splits a directive's arguments into a beamer overlay specification and the
rest, and says how the rest is to be read:

    ''                  ->  ('',      'none',     '')
    '<2-> Results'      ->  ('<2->',  'friendly', 'Results')
    '[Pumping lemma]'   ->  ('',      'latex',    '[Pumping lemma]')
    '0.3'               ->  ('',      'friendly', '0.3')

'latex' arguments are handed to LaTeX exactly as written, which is what
makes an environment we have never heard of usable; 'friendly' ones are a
width or a title, and get interpreted.
"""
    arguments = arguments.strip()

    overlay = ''
    match = OVERLAY_RE.match(arguments)
    if match:
        overlay = match.group(1)
        arguments = arguments[match.end():].strip()

    if not arguments:
        return overlay, 'none', ''
    if arguments[0] in '[{<':
        return overlay, 'latex', arguments
    return overlay, 'friendly', arguments


###########################################
def parse_one_block(source):
    """parse_one_block(Source) -> BlockElement or None

Parses a single block, the way marko's own parse_source() does one turn of
its loop.  A container that ends at a marker of its own cannot use
parse_source(), which keeps going until no element matches at all.
"""
    elements = sorted(
        (element for element in source.parser.block_elements.values()
         if not element.virtual),
        key=lambda element: element.priority, reverse=True)

    for element in elements:
        if element.match(source):
            result = element.parse(source)
            if not hasattr(result, 'priority'):
                # parse() may return the arguments for the constructor
                # rather than the element itself
                result = element(result)
            return result

    return None


###########################################
class MathDisplay(marko.inline.InlineElement):
    """Display maths, '$$ ... $$'."""

    # above Math, so that '$$' is not read as an empty inline '$$'
    priority = 9
    pattern = re.compile(r'(?<!\\)\$\$([\s\S]+?)(?<!\\)\$\$')
    parse_children = False


class Math(marko.inline.InlineElement):
    """Inline maths, '$ ... $'.

Claimed before emphasis, which is what keeps '$pc_1 \\land pc_2$' intact:
left to marko those underscores would pair up into emphasis.  A newline ends
the search, so a stray '$' cannot run away with the rest of the paragraph.
"""

    priority = 8
    pattern = re.compile(r'(?<!\\)\$((?:[^$\n\\]|\\.)+?)(?<!\\)\$')
    parse_children = False


class Graphic(marko.inline.InlineElement):
    """An image, claimed together with its attribute list.

Left to marko the '{ width=0.8 }' would be parsed separately as text and
end up in the output as a stray group next to \\includegraphics.

The title, '![](f.png "ignored")', has nowhere to go in LaTeX and is
dropped, as pandoc drops it; a caption comes from the alt text instead.
"""

    priority = 8
    pattern = IMAGE_RE
    # The whole image is claimed, but only the alt text becomes children, so
    # a caption may hold Markdown just as a directive's title may.
    parse_children = True
    parse_group = 'alt'

    def __init__(self, match):
        self.alt = match.group('alt')       # the raw text, to test emptiness
        self.dest = match.group('dest')
        self.title = match.group('title') or ''
        self.values, self.flags = parse_image_attributes(match.group('attrs'))


class RawLatexInline(marko.inline.InlineElement):
    """A LaTeX macro call in the middle of a sentence, '\\hlbl{...}'.

Claimed as a whole so that Markdown never looks inside the arguments, where
an underscore or an asterisk would otherwise be taken as markup.
"""

    priority = 8
    pattern = re.compile(MACRO)
    parse_children = False
    parse_group = 0             # the pattern has no capturing group


class RawLatexEnvironment(marko.block.BlockElement):
    """A LaTeX environment, '\\begin{tabularx}' to '\\end{tabularx}'.

Everything in between is taken verbatim, which is what lets a table with its
'&' and '\\\\' sit in the middle of a slide.  Left to Markdown, '\\\\' would be
read as an escaped backslash and lose one of them.

This does break a paragraph: a '\\begin{...}' at the start of a line is a
block by any reading, and the deck has one directly below a ':::' line with
no blank line in between.
"""

    priority = 9
    breaks_paragraph = True

    def __init__(self, text):
        self.text = text
        self.children = []

    @classmethod
    def match(cls, source):
        return source.expect_re(BEGIN_ENV_RE)

    @classmethod
    def parse(cls, source):
        first = source.next_line()
        source.consume()

        environment = re.escape(BEGIN_ENV_RE.match(first).group(1))
        begin = re.compile(r'\\begin\{' + environment + r'\}')
        end = re.compile(r'\\end\{' + environment + r'\}')

        # count nesting, so that an inner tabular of the same kind does not
        # end the outer one early
        lines, depth = [first], 1
        while not source.exhausted and depth > 0:
            line = source.next_line()
            if line is None:
                break                       # unterminated; take what we have
            source.consume()
            lines.append(line)
            depth += len(begin.findall(line)) - len(end.findall(line))

        return ''.join(lines).rstrip('\n')


class RawLatexMacroLine(marko.block.BlockElement):
    """A line holding nothing but macro calls, e.g. '\\pausex' or '\\medskip'.

breaks_paragraph is deliberately False, unlike the environment above.  A
'\\pausex' at column 0 in the middle of a list should stay with the item it
follows, as a lazy continuation line, rather than tearing the list in two.
"""

    priority = 9
    breaks_paragraph = False

    def __init__(self, text):
        self.text = text
        self.children = []

    @classmethod
    def match(cls, source):
        if source.expect_re(BEGIN_ENV_RE):
            return None                     # RawLatexEnvironment's business
        return source.expect_re(MACRO_LINE_RE)

    @classmethod
    def parse(cls, source):
        line = source.next_line()
        source.consume()
        return line.strip()


class Directive(marko.block.BlockElement):
    """An environment written as '@name arguments', closed by '@end'.

The body is parsed as Markdown, which is the whole point of having this
alongside \\begin{...}: the two syntaxes say what should happen to the
contents, so no list of environment names has to decide it.

    @column 0.3                 @theorem[Pumping lemma]
    * **Markdown** in here      For every **regular** language ...
    @column 0.7                 @end
    ...
    @end columns

Three things close a directive: an '@end', optionally naming what it
closes; the same name again, for the directives that come in rows, so a
column needs no '@end' before the next one; and a heading, since no
environment should reach past the end of its frame.  An '@end name' closes
anything still open inside it, the way </ul> does in HTML.
"""

    priority = 9
    breaks_paragraph = True

    def __init__(self, info):
        (self.name, self.overlay, self.kind, self.text,
         self.title, self.children) = info

    @classmethod
    def match(cls, source):
        if source.expect_re(DIRECTIVE_END_RE):
            return None                     # StrayDirectiveEnd's business
        return source.expect_re(DIRECTIVE_RE)

    @classmethod
    def parse(cls, source):
        match = source.expect_re(DIRECTIVE_RE)
        name = match.group('name')
        overlay, kind, text = split_directive_arguments(match.group('args'))
        source.next_line()
        source.consume()

        title = []
        if kind == 'friendly' and name not in WIDTH_DIRECTIVES:
            # a title may hold Markdown, '@block Results **so far**'
            title = source.parser.parse(text).children

        children = []
        while not source.exhausted:
            line = source.next_line()
            if line is None:
                break                       # left the enclosing container

            end = DIRECTIVE_END_RE.match(line)
            if end:
                if end.group('name') in (None, name):
                    source.consume()        # ours; a bare @end closes here
                break                       # otherwise an enclosing one's

            sibling = DIRECTIVE_RE.match(line)
            if sibling and name in SIBLING_DIRECTIVES \
                    and sibling.group('name') == name:
                break                       # closed by the next of its kind

            if HEADING_LINE_RE.match(line):
                break                       # closed by the frame boundary

            block = parse_one_block(source)
            if block is None:
                break
            children.append(block)

        return name, overlay, kind, text, title, children


class StrayDirectiveEnd(marko.block.BlockElement):
    """An '@end' with nothing open; reported and dropped rather than printed."""

    priority = 9
    breaks_paragraph = True

    def __init__(self, text):
        self.text = text
        self.children = []

    @classmethod
    def match(cls, source):
        return source.expect_re(DIRECTIVE_END_RE)

    @classmethod
    def parse(cls, source):
        line = source.next_line()
        source.consume()
        return line.strip()


###########################################
def markdown_extension():
    """markdown_extension() -> marko.helpers.MarkoExtension

The elements above, as an extension to register with marko.
"""
    return marko.helpers.MarkoExtension(
        elements=[MathDisplay, Math, Graphic, RawLatexInline,
                  RawLatexEnvironment, RawLatexMacroLine,
                  Directive, StrayDirectiveEnd])


###########################################
def escape_latex(text):
    """escape_latex(str) -> str

Escapes the characters LaTeX treats specially.  Only used where the text is
meant to be taken literally, i.e. inside `inline code'.
"""
    return ''.join(LATEX_ESCAPES.get(char, char) for char in text)


###########################################
def heading_level(element):
    """heading_level(Element) -> int or None

The level of a heading element, or None if it is not a heading.
"""
    if element.get_type() in ('Heading', 'SetextHeading'):
        return element.level
    return None


###########################################
def split_heading_attributes(title):
    """split_heading_attributes(str) -> (str, [str])

Splits a trailing attribute list off a frame title, returning the title and
the frame options it asks for:

    'Algorithm {.fragile}'  ->  ('Algorithm', ['fragile'])
"""
    match = HEADING_ATTRS_RE.search(title)
    if not match:
        return title, []

    options = []
    for token in match.group(1).split():
        if token.startswith('.') and token[1:] in FRAME_OPTIONS:
            options.append(token[1:])
        elif '=' in token:
            options.append(token)
        elif token.startswith('#'):
            options.append('label=%s' % token[1:])

    return title[:match.start()].rstrip(), options


###########################################
def lone_graphic(paragraph):
    """lone_graphic(Paragraph) -> Graphic or None

The one image a paragraph consists of, if that is all it holds apart from
whitespace.  Such an image is a figure rather than something in a sentence.
"""
    found = None

    for child in paragraph.children:
        kind = child.get_type()
        if kind == 'Graphic':
            if found is not None:
                return None                 # more than one
            found = child
        elif kind == 'LineBreak':
            continue
        elif kind == 'RawText' and not child.children.strip():
            continue
        else:
            return None                     # prose alongside the image

    return found


###########################################
def contains_verbatim(elements):
    """contains_verbatim([Element]) -> bool

Whether anything in the subtree is typeset verbatim.  Beamer needs
[fragile] on a frame that holds a listing, because it has to read the frame
body twice.
"""
    for element in elements:
        kind = element.get_type()
        if kind in ('FencedCode', 'CodeBlock'):
            return True
        if kind in ('RawLatexEnvironment', 'RawLatexMacroLine') \
                and VERBATIM_RE.search(element.text):
            return True
        if kind == 'RawLatexInline' and VERBATIM_RE.search(element.children):
            return True
        children = getattr(element, 'children', None)
        if children and not isinstance(children, str) \
                and contains_verbatim(children):
            return True
    return False


###########################################
class BeamerRenderer(marko.Renderer):
    """Renders a parsed Markdown document as the body of a Beamer document.

Prose is passed through to LaTeX untouched: whatever marko does not
recognize as Markdown is assumed to be LaTeX and left alone.  That is what
lets \\hlbl{...} and \\ldots work in the middle of a sentence.  Escaping only
happens inside `inline code', where the text is meant to be literal.
"""

    #: heading level that starts a new frame; set by make_markdown()
    slide_level = 1

    #: escape character for ```lstlisting fences; set by make_markdown()
    escapechar = LISTINGS_ESCAPECHAR

    ####################
    # document structure
    ####################

    def render_document(self, element):
        parts = []
        for kind, heading, nodes in self.split_slides(element.children):
            if kind == 'section':
                title, _ = split_heading_attributes(self.render_children(heading))
                parts.append('\\section{%s}\n' % title)
            else:
                parts.append(self.render_frame(heading, nodes))
        return '\n'.join(parts)

    def split_slides(self, children):
        """split_slides([Element]) -> [(str, Element or None, [Element])]

Groups the top level of the document into sections and frames.  A heading
above the slide level becomes a \\section, one at the slide level starts a
frame, and a thematic break starts a frame with no title.
"""
        slides = []
        frame = None

        for child in children:
            level = heading_level(child)
            if level is not None and level < self.slide_level:
                slides.append(('section', child, []))
                frame = None
            elif level == self.slide_level:
                frame = []
                slides.append(('frame', child, frame))
            elif child.get_type() == 'ThematicBreak':
                frame = []
                slides.append(('frame', None, frame))
            elif frame is None:
                # material before the first heading: skip the blank lines
                # left behind by the metadata block, keep anything else
                if child.get_type() == 'BlankLine':
                    continue
                frame = [child]
                slides.append(('frame', None, frame))
            else:
                frame.append(child)

        return slides

    def render_frame(self, heading, nodes):
        """render_frame(Element or None, [Element]) -> str"""
        options = []
        title = ''
        if heading is not None:
            title, options = split_heading_attributes(
                self.render_children(heading))
        if contains_verbatim(nodes) and 'fragile' not in options:
            options.insert(0, 'fragile')

        head = '\\begin{frame}'
        if options:
            head += '[%s]' % ','.join(options)
        if title:
            head += '{%s}' % title

        body = ''.join(self.render(node) for node in nodes)
        return '%s\n%s\\end{frame}\n' % (head, body)

    ####################
    # blocks
    ####################

    def render_paragraph(self, element):
        # an image alone in a paragraph, with alt text, is a captioned
        # figure; otherwise the alt text would be dropped on the floor
        graphic = lone_graphic(element)
        if graphic is not None and graphic.alt.strip():
            return ('\\begin{figure}\n\\centering\n%s\n\\caption{%s}\n'
                    '\\end{figure}\n'
                    % (self.render(graphic), self.render_children(graphic)))

        text = self.render_children(element)
        return text + ('\n' if element._tight else '\n\n')

    def render_blank_line(self, element):
        return ''

    def render_line_break(self, element):
        return '\n' if element.soft else '\\\\\n'

    def render_list(self, element):
        environment = 'enumerate' if element.ordered else 'itemize'
        return '\\begin{%s}\n%s\\end{%s}\n' % (
            environment, self.render_children(element), environment)

    def render_list_item(self, element):
        body = self.render_children(element).lstrip()
        if not body.strip():
            return '\\item\n'
        return '\\item %s' % (body if body.endswith('\n') else body + '\n')

    def render_quote(self, element):
        return '\\begin{quote}\n%s\\end{quote}\n' % self.render_children(element)

    def render_fenced_code(self, element):
        return self.render_listing(element.lang, element.children[0].children)

    def render_code_block(self, element):
        return self.render_listing('', element.children[0].children)

    def render_listing(self, language, code):
        """render_listing(str, str) -> str"""
        options = []
        name = (language or '').strip().lower()

        if name in RAW_LISTING_LANGUAGES:
            # the author is writing listings input, so let the escapes work
            if self.escapechar:
                options.append('escapechar=%s' % self.escapechar)
        elif LISTINGS_LANGUAGES.get(name):
            # braces: a '[dialect]language' value would otherwise break the
            # option parser of listings
            options.append('language={%s}' % LISTINGS_LANGUAGES[name])

        head = '\\begin{lstlisting}'
        if options:
            head += '[%s]' % ','.join(options)
        if not code.endswith('\n'):
            code += '\n'
        return '%s\n%s\\end{lstlisting}\n' % (head, code)

    def render_heading(self, element):
        # A heading below the slide level.  TODO: \begin{block}{...}, which
        # needs the following siblings, not just this element.
        title, _ = split_heading_attributes(self.render_children(element))
        return '\\textbf{%s}\\par\n' % title

    def render_setext_heading(self, element):
        return self.render_heading(element)

    def render_thematic_break(self, element):
        # only reached inside a container; at the top level it starts a frame
        return '\\medskip\\hrule\\medskip\n'

    def render_directive(self, element):
        body = self.render_children(element)
        arguments = self.directive_arguments(element)

        if element.name in COMMAND_DIRECTIVES:
            return '\\%s%s{%%\n%s}\n' % (element.name, element.overlay, body)

        return '\\begin{%s}%s%s\n%s\\end{%s}\n' % (
            element.name, element.overlay, arguments, body, element.name)

    def directive_arguments(self, element):
        """directive_arguments(Directive) -> str"""
        if element.kind == 'latex':
            return element.text             # exactly as written
        if element.kind == 'none':
            return ''

        if element.name in WIDTH_DIRECTIVES:
            if BARE_NUMBER_RE.match(element.text):
                return '{%s\\textwidth}' % element.text
            return '{%s}' % element.text    # a length such as 4cm

        title = ''.join(self.render(block) for block in element.title).strip()
        if element.name in BRACKET_TITLE_DIRECTIVES:
            return '[%s]' % title
        return '{%s}' % title

    def render_stray_directive_end(self, element):
        print("%s: warning: '%s' with nothing open" % (PROG, element.text),
              file=sys.stderr)
        return ''

    def render_raw_latex_environment(self, element):
        return element.text + '\n'

    def render_raw_latex_macro_line(self, element):
        return element.text + '\n'

    def render_html_block(self, element):
        return ''       # commented-out slides and <!-- notes -->

    def render_link_ref_def(self, element):
        return ''

    ####################
    # inline
    ####################

    def render_raw_text(self, element):
        return element.children         # straight through to LaTeX

    def render_math(self, element):
        return '$%s$' % element.children

    def render_math_display(self, element):
        return '\\[%s\\]' % element.children

    def render_raw_latex_inline(self, element):
        return element.children

    def render_literal(self, element):
        char = element.children
        return '\\' + char if char in LATEX_SPECIALS else char

    def render_emphasis(self, element):
        return '\\emph{%s}' % self.render_children(element)

    def render_strong_emphasis(self, element):
        return '\\textbf{%s}' % self.render_children(element)

    def render_code_span(self, element):
        return '\\texttt{%s}' % escape_latex(element.children)

    def render_link(self, element):
        return '\\href{%s}{%s}' % (element.dest.replace('%', '\\%'),
                                   self.render_children(element))

    def render_auto_link(self, element):
        return '\\url{%s}' % element.dest.replace('%', '\\%')

    def render_image(self, element):
        # a reference-style image, '![alt][ref]', which carries no attributes
        return '\\includegraphics{%s}' % element.dest

    def render_graphic(self, element):
        options = []
        for key, value in element.values.items():
            relative_to = IMAGE_LENGTHS.get(key)
            if relative_to and BARE_NUMBER_RE.match(value):
                value = '%s\\%s' % (value, relative_to)
            options.append('%s=%s' % (key, value))
        options.extend(element.flags)

        graphic = '\\includegraphics'
        if options:
            graphic += '[%s]' % ','.join(options)
        return graphic + '{%s}' % element.dest

    def render_inline_html(self, element):
        return ''


###########################################
def make_markdown(opts):
    """make_markdown(argparse.Namespace) -> marko.Markdown

marko instantiates the renderer itself, so the options it needs are handed
over as class attributes of a throwaway subclass.
"""
    renderer = type('_BeamerRenderer', (BeamerRenderer,),
                    {'slide_level': opts.slide_level,
                     'escapechar': opts.escapechar})
    return marko.Markdown(renderer=renderer,
                          extensions=[markdown_extension()])


###########################################
def convert(text, template, opts):
    """convert(str, str, argparse.Namespace) -> str

Converts the Markdown source `text' into a complete Beamer document.
"""
    meta, body = split_frontmatter(text)

    # -V overrides the metadata block before anything is derived from it, so
    # that '-V title=...' also reaches the short title in the footline.
    meta.update(opts.variable)

    markdown = make_markdown(opts)
    ast = markdown.parse(body)
    if opts.dump_ast:
        for child in ast.children:
            print(child, file=sys.stderr)
    slides = markdown.render(ast)

    variables = build_variables(meta, slides)
    # -V can also set a template variable that is not metadata at all
    variables.update(opts.variable)

    return string.Template(template).safe_substitute(variables)


###########################################
def parse_args(argv=None):
    """parse_args([str]) -> argparse.Namespace"""
    parser = argparse.ArgumentParser(
                prog=PROG,
                description="Convert Markdown into LaTeX Beamer slides.")
    parser.add_argument("file", nargs="?", default='-', metavar='FILE',
                        help="input markdown file, '-' for stdin "
                             "(default: stdin)")
    parser.add_argument('-o', '--output', metavar='FILE', default='-',
                        help="output .tex file, '-' for stdout "
                             "(default: stdout)")
    parser.add_argument('-t', '--template', metavar='FILE',
                        help="Beamer template file (default: %s next to this "
                             "script, or $%s)"
                             % (DEFAULT_TEMPLATE, TEMPLATE_ENV_VAR))
    parser.add_argument('-V', '--variable', action='append', default=[],
                        metavar='KEY=VALUE',
                        help="set a template variable, overriding the "
                             "metadata block (repeatable)")
    parser.add_argument('-l', '--slide-level', type=int, default=1,
                        metavar='N',
                        help="heading level that starts a new frame "
                             "(default: %(default)s)")
    parser.add_argument('--escapechar', default=LISTINGS_ESCAPECHAR,
                        metavar='CHAR',
                        help="escape character inside ```lstlisting blocks, "
                             "empty to switch it off (default: %(default)s)")
    parser.add_argument('-d', '--dump-ast', action='store_true',
                        help="dump the parsed Markdown tree to stderr")
    parser.add_argument('--version', action='version',
                        version='%(prog)s ' + VERSION)

    args = parser.parse_args(argv)

    # -V key=value pairs are more useful as a dict
    variables = {}
    for item in args.variable:
        key, sep, value = item.partition('=')
        if not sep:
            parser.error("-V expects KEY=VALUE, got '%s'" % item)
        variables[key.strip()] = value
    args.variable = variables

    args.file = open_file(parser, args.file, 'r', sys.stdin, 'input file')
    args.output = open_file(parser, args.output, 'w', sys.stdout, 'output file')

    if args.template is None:
        args.template = open_file(parser, find_template(), 'r',
                                  what='default template')
    else:
        args.template = open_file(parser, args.template, 'r', what='template')

    return args


###########################################
if __name__ == '__main__':
    args = parse_args()

    args.output.write(convert(args.file.read(), args.template.read(), args))
