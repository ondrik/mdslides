# \setbeamertemplate{section page} from its header-includes.
#
# \frame[...]{...} rather than \begin{frame}...\end{frame} so that no frame
# environment appears in the preamble, where it would be counted by anything
# looking for the document's slides.
DEFAULT_TOC_TITLE = 'Outline'

# Links are coloured so that they can be told from the prose around them.
# Only the links in the text are touched, never beamer's own navigation:
# hyperref's colorlinks would repaint the footline too, which on a dark
# theme makes it unreadable -- blue on blue.  A deck that wants hyperref's
# global behaviour can still \hypersetup from its header-includes.
DEFAULT_URL_COLOR = 'blue'

SECTION_PAGE_HOOKS = '\n'.join(
    '\\AtBegin%s%s{\\frame[plain,noframenumbering]{\\%spage}}'
    % (level.capitalize(), '' if level == 'part' else '[]', level)
    for level in ('part', 'section', 'subsection'))

# Metadata that is a list of people or places, rather than a block of text.
JOINED_WITH_AND = ('author', 'institute')

# Short forms for the footline; each falls back to its long form.
SHORT_FORMS = (('shorttitle', 'title'),
               ('shortauthor', 'author'),
               ('shortdate', 'date'),
               # beamer puts this in the footline next to the author; the
               # full affiliation does fit at 16:9, and pandoc shows it too
               ('shortinstitute', 'institute'))

# Characters that have to be escaped where LaTeX is not wanted, i.e. inside
# `inline code'.  Prose is passed through untouched; see BeamerRenderer.
# Characters that have to be escaped in a URL before it can be the argument
# of \href.  A '#' is the one that bites: LaTeX reads it as a parameter.
URL_ESCAPES = {'#': '\\#', '%': '\\%', '{': '\\%7B', '}': '\\%7D'}

LATEX_ESCAPES = {
    '\\': '\\textbackslash{}', '{': '\\{', '}': '\\}', '$': '\\$',
    '&': '\\&', '#': '\\#', '_': '\\_', '%': '\\%',
    '~': '\\~{}', '^': '\\^{}',
}

# '\_' in Markdown means a literal underscore, which LaTeX also spells '\_';
# '\*' on the other hand is just an asterisk.
LATEX_SPECIALS = set('#$%&_{}')

# Classes recognized in a frame's attribute list, '# Title {.fragile}'.
FRAME_OPTIONS = ('fragile', 'plain', 'allowframebreaks', 'shrink', 'squeeze',
                 'noframenumbering', 't', 'b', 'c')

# Classes that make a heading open a sectioning level and produce a separator
# slide for it: '# Part II {.section}'.  Beamer has a page template for each,
# so \section is followed by \frame{\sectionpage} and so on.
SECTIONING_CLASSES = ('part', 'section', 'subsection')

# A trailing attribute list on a heading: '{.fragile}', '{label=intro}'.  The
# tokens have to look like attributes, so that a title ending in \hlbl{Foo}
# is not mistaken for one.
HEADING_ATTRS_RE = re.compile(
    r'\s*\{((?:\s*[.#][-\w]+|\s*[-\w]+=[^{}\s]+)+)\s*\}\s*$')

# Fence languages that mean "this is listings input, not a language": the
# body is handed to lstlisting as it stands, with escapechar switched on so
# that '@$x_1$@' typesets as maths instead of printing as itself.  Only
# these fences get it, since a C snippet is free to contain an '@'.
RAW_LISTING_LANGUAGES = ('lstlisting', 'listings')
LISTINGS_ESCAPECHAR = '@'

# An error as -file-line-error writes it: './deck.tex:150: Missing $ inserted.'
# The path is anything up to the last colon-digits-colon, since it may itself
# contain a colon.
FILE_LINE_ERROR_RE = re.compile(r'^.+:\d+: .')

# Fence languages that the listings package knows.  It errors out on a
# language it cannot load, so anything missing here becomes a plain listing.
# A '[dialect]language' value has to reach LaTeX inside braces, and some
# languages (Lua) have dialects but no default, so naming one is mandatory.
# Every value below was checked by compiling it.
LISTINGS_LANGUAGES = {
    'c': 'C', 'c++': 'C++', 'cpp': 'C++', 'haskell': 'Haskell',
    'hs': 'Haskell', 'java': 'Java', 'python': 'Python', 'py': 'Python',
    'bash': 'bash', 'sh': 'sh', 'shell': 'sh', 'sql': 'SQL', 'tex': 'TeX',
    'latex': '[LaTeX]TeX', 'lua': '[5.3]Lua', 'perl': 'Perl', 'php': 'PHP',
    'ruby': 'Ruby', 'prolog': 'Prolog', 'lisp': 'Lisp', 'ml': 'ML',
    'caml': 'Caml', 'ocaml': '[Objective]Caml', 'r': 'R', 'matlab': 'Matlab',
    'xml': 'XML', 'html': 'HTML', 'make': 'make', 'makefile': 'make',
    'llvm': 'LLVM', 'verilog': 'Verilog', 'vhdl': 'VHDL',
    'fortran': 'Fortran', 'pascal': 'Pascal', 'ada': 'Ada',
}

# A fenced div, ':::' or more colons.  With an info string it opens one, on
# its own it closes one:  '::: { .column width=30% }' ... ':::'
DIV_FENCE_RE = re.compile(r'(:{3,})[ \t]*(.*?)[ \t]*$', re.MULTILINE)

# A code fence, so that a ':::' inside a listing is not mistaken for a div.
CODE_FENCE_RE = re.compile(r'[ \t]*(`{3,}|~{3,})')

# The classes of a bracketed span, '[text]{.hlrd .bf}'.  Each becomes a
# macro wrapped around the text, so the class is the macro name.
SPAN_CLASS_RE = re.compile(r'\.([A-Za-z@][-\w@]*)')

# The macro '==highlighted==' becomes, unless the metadata says otherwise.
DEFAULT_HIGHLIGHT = 'hlbl'

# A '"' opens a quotation when it follows one of these, or nothing at all,
# and closes one otherwise.  Deciding from the character before it is what
# lets "easily" come out as ``easily'' without having to pair the quotes up.
QUOTE_OPENS_AFTER = set(' \t\n([{<' '‘“–—-/')

# A whole-line '%' comment, stripped before marko runs.  Anything after the
# first non-blank character being a '%' goes; an escaped '\%' does not match,
# since the line then starts with a backslash.
COMMENT_LINE_RE = re.compile(r'[ \t]*%')

# A fenced code block, and a verbatim LaTeX environment: the two places where
# a leading '%' is content rather than a comment.
CODE_FENCE_RE = re.compile(r'[ \t]{0,3}(`{3,}|~{3,})')
# Environments whose contents are taken literally.  A '%' line inside one is
# content, and so is a '# ' line -- a shell or Python comment, not a heading --
# which is why RawLatexEnvironment does not let a heading close one of these.
VERBATIM_ENVIRONMENTS = ('lstlisting', 'verbatim', 'Verbatim', 'alltt',
                         'minted', 'semiverbatim', 'comment')
VERBATIM_BEGIN_RE = re.compile(
    r'[ \t]*\\begin\{(' + '|'.join(VERBATIM_ENVIRONMENTS) + r')\}')

# An image, with an optional title and an optional attribute list:
#   ![alt](figure.png "title"){ width=0.8 }
# Claimed whole, so that the attributes do not reach LaTeX as stray text.
IMAGE_RE = re.compile(r"""
    !\[(?P<alt>[^\]]*)\]
    \([ \t]*<?(?P<dest>[^)\s>]*)>?
    (?:[ \t]+(?P<quote>["'])(?P<title>.*?)(?P=quote))?
    [ \t]*\)
    (?:[ \t]*\{(?P<attrs>[^{}]*)\})?
""", re.VERBOSE)

# One item of an image's attribute list: 'width=0.8' or a bare flag.
IMAGE_ATTRIBUTE_RE = re.compile(r"""[ \t]*(?:
      (?P<key>[-\w]+)[ \t]*=[ \t]*(?P<value>"[^"]*"|'[^']*'|[^\s}]+)
    | (?P<flag>[-.#\w]+)
)""", re.VERBOSE)

# Keys measured against the slide, so a bare number is a fraction of it.
IMAGE_LENGTHS = {'width': 'textwidth', 'height': 'textheight'}

# An environment directive, '@column 0.3' ... '@end column'.  The contents
# are Markdown; write \begin{...} instead when they should be left alone.
DIRECTIVE_RE = re.compile(r'[ \t]{0,3}@(?P<name>[A-Za-z][-\w]*)(?P<args>.*)$',
                          re.MULTILINE)
DIRECTIVE_END_RE = re.compile(
    r'[ \t]{0,3}@end(?:[ \t]+(?P<name>[A-Za-z][-\w]*))?[ \t]*$', re.MULTILINE)

# A beamer overlay specification, '<2->', allowed in front of the arguments.
OVERLAY_RE = re.compile(r'(<[^>\n]*>)[ \t]*')

# An ATX heading, which closes any directive still open: a frame boundary is
# as far as an environment can reach.
HEADING_LINE_RE = re.compile(r'[ \t]{0,3}#{1,6}(?:[ \t]|$)')

# A bare number is a fraction of \textwidth, so '@column 0.3' is enough.
BARE_NUMBER_RE = re.compile(r'\d*\.?\d+$')

# Sugar, not semantics: an unlisted directive still works, you just write
# the brackets yourself.  A friendly argument becomes a width for these,
WIDTH_DIRECTIVES = frozenset(('column', 'minipage'))

# an optional [title] for these, since that is what theorem-likes take,
BRACKET_TITLE_DIRECTIVES = frozenset("""
    theorem lemma corollary definition example proof remark proposition
    claim fact observation conjecture
""".split())

# and a mandatory {title} for anything else, which is what block-likes want.

# Directives that are a command rather than an environment: '@note' becomes
# \note{...}, so Markdown can be written inside something beamer spells as a
# macro argument.
COMMAND_DIRECTIVES = frozenset(('note', 'alert', 'only', 'uncover', 'visible',
                                'invisible'))

# Directives where repeating the name closes the previous one instead of
# nesting inside it, so a row of columns needs no @end between them.
SIBLING_DIRECTIVES = frozenset(('column',))

# Arguments supplied when a directive is given none.  Without [T] beamer
# centres the columns against each other, so a short column of code ends up
# floating in the middle beside a tall table.  Write '@columns[c]' for the
# centred behaviour.
DIRECTIVE_DEFAULT_ARGUMENTS = {'columns': '[T]'}

# A LaTeX macro call: \name, \name*, \name[opt]{arg}, \name{a}{b}.  Regular
# expressions cannot count, so brace nesting is spelled out to three levels,
# which covers anything written by hand.
BRACED = r'\{(?:[^{}]|\{(?:[^{}]|\{[^{}]*\})*\})*\}'
MACRO = r'\\[A-Za-z@]+\*?(?:\[[^\]\n]*\])?(?:' + BRACED + r')*'

# A line holding nothing but macro calls, e.g. '\pausex' or '\medskip'.
MACRO_LINE_RE = re.compile(r'[ \t]*(?:' + MACRO + r'[ \t]*)+$', re.MULTILINE)

# The start of a LaTeX environment, '\begin{tabularx}'.
BEGIN_ENV_RE = re.compile(r'[ \t]*\\begin\{([A-Za-z@*]+)\}')

# An ordered list's marker, extending CommonMark's '1.' and '1)' with the
# lettered and roman forms a slide actually wants: '(a)', 'b)', '(iv)', '(1)'.
#
# A letter or a numeral is accepted only against a parenthesis, never as
# 'A.', which would turn a line beginning 'A. Turing wrote' into a list.  The
# bare '1.' keeps its CommonMark meaning, parentheses and all.
ROMAN_RE = re.compile(
    r'(?i)m{0,3}(?:cm|cd|d?c{0,3})(?:xc|xl|l?x{0,3})(?:ix|iv|v?i{0,3})$')
ROMAN_VALUES = {'i': 1, 'v': 5, 'x': 10, 'l': 50, 'c': 100, 'd': 500,
                'm': 1000}
LETTERED = r'[A-Za-z]|[ivxlcdm]{2,}|[IVXLCDM]{2,}'
LIST_MARKER_RE = re.compile(
    r' {,3}(\((?:\d{1,9}|' + LETTERED + r')\)'
    r'|(?:' + LETTERED + r')\)'
    r'|\d{1,9}[.)]'
    r'|[*\-+])[ \t\n\r\f]')

# \setcounter needs the counter by name, and LaTeX has four.
ENUM_COUNTERS = ('enumi', 'enumii', 'enumiii', 'enumiv')

# A slide's own metadata block: '===', YAML, and a closing '---'.
#
# The opener is not '---' on purpose.  A '---' starts a slide, and two of
# them with a slide between have exactly the shape of a block, so an opener
# of '---' had to be told from a pair of breaks by guesswork -- and the first
# cut of this got it wrong and ate the slide between every pair.  '===' says
# at the opening line which of the two this is, and a pair of breaks can no
# longer be a block at all.  A bare '===' is left alone: it is the block that
# starts a slide, and a slide wanting no settings needs no block.
# The content is a run of *non-blank* lines that are not a fence of their
# own, which keeps a block from reaching past the slide it belongs to.
SLIDE_METADATA_RE = re.compile(
    r'(?m)===[ \t]*\n'
    r'((?:(?!(?:---|\.\.\.|```|~~~)[ \t]*$)[^\n\S]*\S[^\n]*\n)+?)'
    r'(?:---|\.\.\.)[ \t]*(?:\n|\Z)')

# Keys a slide's metadata block understands.  Anything else is ignored, since
# a slide has no template to pass it to.
SLIDE_METADATA_KEYS = ('title', 'label', 'options', 'itemsep',
                       'part', 'section', 'subsection')

# Metadata values that become prose on a slide, and are therefore parsed as
# Markdown.  Everything else -- a theme, header-includes, a colour -- reaches
# the template exactly as YAML read it.
MARKDOWN_METADATA = ('title', 'subtitle', 'author', 'institute', 'date',
                     'short-title', 'short-author', 'short-institute',
                     'short-date', 'toc-title')

# Environments and macros that typeset their contents verbatim, so that a
# frame containing raw LaTeX still gets [fragile].
VERBATIM_RE = re.compile(r'\\begin\{(?:lstlisting|verbatim|Verbatim|alltt'
                         r'|minted|semiverbatim)\}|\\verb|\\lstinline')

# A YAML metadata block, fenced by '---' and closed by '---' or '...'.  Only
# recognized at the very start of the document, where CommonMark would
# otherwise see a thematic break.
FRONTMATTER_RE = re.compile(r"""\A---[ \t]*\r?\n              # opening fence
                                (.*?)                         # the YAML itself
                                ^(?:---|\.\.\.)[ \t]*\r?$\r?\n?  # closing fence
                             """, re.DOTALL | re.MULTILINE | re.VERBOSE)

# HTML comments are legal in Markdown but not in YAML, and they are a handy
# way to disable a metadata line, e.g. '<!--lang: en-->'.
YAML_COMMENT_RE = re.compile(r'^[ \t]*<!--.*?-->[ \t]*$\n?', re.MULTILINE)


###########################################
def find_template():
    """find_template() -> str

Returns the path to the default template: the one named by $MD_SLIDES_TEMPLATE
if set, otherwise the one shipped next to this script.
"""
    from_env = os.environ.get(TEMPLATE_ENV_VAR)
    if from_env:
        return from_env

    return os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        DEFAULT_TEMPLATE)


###########################################
def same_file(one, other):
    """same_file(str, str) -> bool

Whether two paths lead to the same file.  os.path.samefile() needs both to
exist, which the output usually does not, so the names are normalized instead
and samefile() is only consulted when it can answer -- which is what catches a
symlink or a second mount.
"""
    try:
        return os.path.samefile(one, other)
    except OSError:
        return (os.path.normcase(os.path.abspath(one))
                == os.path.normcase(os.path.abspath(other)))


###########################################
def open_file(parser, path, mode, standard=None, what='file'):
    """open_file(ArgumentParser, str, str, file, str) -> file

Opens `path' in `mode', or returns `standard' if the path is '-'.  Files are
UTF-8 regardless of the locale, since a deck is likely to contain accented
characters.  A path that cannot be opened is a usage error, reported through
`parser', which exits with status 2.
"""
    if path == '-' and standard is not None:
        # Make sure a piped deck is decoded as UTF-8 too.  Under pytest the
        # standard streams are replaced by objects without reconfigure().
        if hasattr(standard, 'reconfigure'):
            standard.reconfigure(encoding='utf-8')
        return standard

    try:
        return open(path, mode, encoding='utf-8')
    except OSError as exc:
        parser.error("cannot open the %s '%s': %s"
                     % (what, path, exc.strerror))


###########################################
def open_output(parser, path, standard=None):
    """open_output(ArgumentParser, str, file) -> file

Opens the file the document is written to, or returns `standard' for '-'.

For a real path this is a *temporary* file beside it, which finish_output()
then renames over the target.  Opening the target itself would truncate it
here, before a byte of the input has been read, so a document that failed to
convert -- a broken metadata block is enough -- replaced the previous .tex
with an empty one.  Creating the temporary file in the same directory keeps
the early check that the path can be written at all, and makes the write
atomic into the bargain.
"""
    if path == '-' and standard is not None:
        if hasattr(standard, 'reconfigure'):
            standard.reconfigure(encoding='utf-8')
        return standard

    try:
        handle = tempfile.NamedTemporaryFile(
            mode='w', encoding='utf-8', delete=False,
            dir=os.path.dirname(os.path.abspath(path)),
            prefix='.' + os.path.basename(path) + '.', suffix='.tmp')
    except OSError as exc:
        parser.error("cannot open the output file '%s': %s"
                     % (path, exc.strerror))

    # A temporary file is created 0600, which is not what writing a .tex
    # should leave behind.  Match the file being replaced where there is one,
    # and otherwise what a plain open() would have made.
    try:
        os.chmod(handle.name, stat.S_IMODE(os.stat(path).st_mode))
    except OSError:
        umask = os.umask(0)
        os.umask(umask)
        os.chmod(handle.name, 0o666 & ~umask)

    return handle


###########################################
def finish_output(args):
    """finish_output(Namespace) -> None

Closes the output and, when it went to a temporary file, renames it over the
target.  os.replace() is atomic, so a reader never sees a half-written .tex.
"""
    if args.output_path is None:
        return

    args.output.close()
    os.replace(args.output.name, args.output_path)


###########################################
def discard_output(args):
    """discard_output(Namespace) -> None

Throws the temporary file away, leaving whatever was at the target alone.
"""
    if args.output_path is None:
        return

    args.output.close()
    try:
        os.remove(args.output.name)
    except OSError:
        pass


###########################################
def run_latex(path, quiet=True):
    """run_latex(str, bool) -> int

Turns the generated .tex into a PDF and returns the exit status.

latexmk is preferred: it works out for itself how many passes are needed.
Failing that, pdflatex is run twice, which is what beamer needs before its
overlay and page counters settle.  On failure the errors are lifted out of
the .log, since the engine's own output buries them.
"""
    directory = os.path.dirname(os.path.abspath(path)) or '.'
    name = os.path.basename(path)
    flags = ['-interaction=nonstopmode', '-file-line-error']

    if shutil.which('latexmk'):
        # -silent keeps its running commentary (and the harmless note about
        # the .nav file it is about to create) out of the way; errors still
        # reach the log, which is where we read them from anyway
        runs = [['latexmk', '-pdf'] + (['-silent'] if quiet else []) +
                flags + [name]]
    elif shutil.which('pdflatex'):
        runs = 2 * [['pdflatex'] + flags + [name]]
    else:
        print('%s: neither latexmk nor pdflatex found' % PROG, file=sys.stderr)
        return 1

    for command in runs:
        print('%s: %s %s' % (PROG, command[0], name), file=sys.stderr)
        done = subprocess.run(command, cwd=directory,
                              stdout=subprocess.DEVNULL if quiet else None)
        if done.returncode:
            report_latex_errors(os.path.join(
                directory, os.path.splitext(name)[0] + '.log'))
            return done.returncode

    return 0


###########################################
def report_latex_errors(log_path):
    """report_latex_errors(str) -> None

Prints the lines LaTeX marked as errors, and where to read the rest.

Two spellings, because run_latex() asks for -file-line-error: TeX rewrites an
error that has a line to blame as './deck.tex:150: Undefined control
sequence.' and leaves the rest -- a missing package, say -- beginning with
'!'.  Matching only the second is how an undefined macro used to produce no
message at all.
"""
    try:
        with open(log_path, encoding='utf-8', errors='replace') as handle:
            lines = handle.read().splitlines()
    except OSError:
        return

    for line in lines:
        if line.startswith('!') or FILE_LINE_ERROR_RE.match(line):
            print('  %s' % line, file=sys.stderr)

    print('%s: see %s' % (PROG, log_path), file=sys.stderr)


###########################################
def split_frontmatter(text):
    """split_frontmatter(str) -> (dict, str)

Splits the leading YAML metadata block off `text' and returns the parsed
metadata together with the remaining Markdown body.  A document without a
metadata block yields an empty dict and the text unchanged.

The block is replaced by as many blank lines as it occupied, so that line
numbers in the body still match the input file.
"""
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}, text

    try:
        meta = yaml.safe_load(YAML_COMMENT_RE.sub('', match.group(1)))
    except yaml.YAMLError as exc:
        sys.exit("%s: cannot parse the metadata block: %s" % (PROG, exc))

    if meta is None:            # an empty metadata block
        meta = {}
    if not isinstance(meta, dict):
        sys.exit("%s: the metadata block must be a mapping, got %s"
                 % (PROG, type(meta).__name__))

    return meta, '\n' * match.group(0).count('\n') + text[match.end():]


###########################################
def strip_comments(text):
    """strip_comments(str) -> str

Removes whole-line '%' comments before marko sees them, so that a note to
yourself never reaches the output at all.  A line counts as a comment when
its first character other than whitespace is a '%'.

The line is removed rather than blanked: a blank line would end a paragraph
and make a list loose, so blanking would let a comment change the slide
around it.  Line numbers therefore shift, which nothing reports on yet.

Two places a leading '%' is content and is left alone: inside a fenced code
block, where it may be Matlab or a printf format, and inside a verbatim
LaTeX environment written out by hand.  An inline '%' partway along a line
is also left alone -- it would be too easy to eat the rest of an
`inline code` span -- and still reaches LaTeX, where it is still a comment.
"""
    kept = []
    fence = None                # the backticks or tildes that opened a block
    verbatim = None             # the name of a verbatim environment

    for line in text.splitlines(keepends=True):
        if fence is not None:
            kept.append(line)
            match = CODE_FENCE_RE.match(line)
            if match and match.group(1)[0] == fence[0] \
                    and len(match.group(1)) >= len(fence):
                fence = None
            continue

        if verbatim is not None:
            kept.append(line)
            if re.match(r'[ \t]*\\end\{%s\}' % re.escape(verbatim), line):
                verbatim = None
            continue

        match = CODE_FENCE_RE.match(line)
        if match:
            fence = match.group(1)
            kept.append(line)
            continue

        match = VERBATIM_BEGIN_RE.match(line)
        if match:
            verbatim = match.group(1)
            kept.append(line)
            continue

        if COMMENT_LINE_RE.match(line):
            continue            # a comment: drop it

        kept.append(line)

    return ''.join(kept)


###########################################
def roman_value(text):
    """roman_value(str) -> int"""
    total = largest = 0
    for char in reversed(text.lower()):
        value = ROMAN_VALUES[char]
        total += -value if value < largest else value
        largest = max(largest, value)
    return total


###########################################
def split_marker(bullet):
    """split_marker(str) -> (str, str) or (None, None)

An ordered list marker as its delimiter and the text inside it: '(a)' is
('(%s)', 'a'), '2.' is ('%s.', '2').  (None, None) for a bullet.
"""
    if bullet.startswith('(') and bullet.endswith(')'):
        return '(%s)', bullet[1:-1]
    if bullet.endswith(')'):
        return '%s)', bullet[:-1]
    if bullet.endswith('.'):
        return '%s.', bullet[:-1]
    return None, None


###########################################
def marker_value(body, counter):
    """marker_value(str, str) -> int or None

What a marker counts to when read in a given style, or None when it cannot
be read that way at all.
"""
    if counter == '1':
        return int(body) if body.isdigit() else None

    if counter in ('i', 'I'):
        if not ROMAN_RE.match(body):
            return None
        if body.islower() != (counter == 'i'):
            return None
        return roman_value(body)

    if len(body) != 1 or not body.isalpha():
        return None
    if body.islower() != (counter == 'a'):
        return None
    return ord(body.lower()) - ord('a') + 1


###########################################
def list_marker(bullet, counter=None):
    """list_marker(str, str) -> (str, str, int) or None

The delimiter, counter and value of an ordered list's marker, or None for a
bullet: '(a)' is ('(%s)', 'a', 1), '2.' is ('%s.', '1', 2) and '(iv)' is
('(%s)', 'i', 4).

The counter is the character beamer reads as "number it this way", so the
delimiter with the counter in it is the template for the list -- which is
why the author writing the first label is all it takes to set them all.

With `counter' given the marker is read in that style, which is how a list
goes on: the first marker settles what the list is, and '(v)' after '(iv)'
is then five rather than the twenty-second letter.  Settling it per marker
instead would end a roman list at (v), and again at (x).

Deciding it the first time, a lone 'i' is roman, since that is what anyone
writing '(i)' means; every other single letter is alphabetic.  Ambiguity has
to fall somewhere, and a list that opens at (v) is rarer than one that opens
at (i).
"""
    delimiter, body = split_marker(bullet)
    if not body:
        return None

    if counter is None:
        if body.isdigit():
            counter = '1'
        elif (len(body) > 1 or body.lower() == 'i') and ROMAN_RE.match(body):
            counter = 'i' if body.islower() else 'I'
        elif len(body) == 1 and body.isalpha():
            counter = 'a' if body.islower() else 'A'
        else:
            return None

    value = marker_value(body, counter)
    return None if value is None else (delimiter, counter, value)


###########################################
def same_list_family(bullet, other):
    """same_list_family(str, str) -> bool

Whether `bullet' continues the list `other' opened.  Two bullets agree when
they are the same character, as CommonMark says.  A number agrees when it is
written the same way and can be read in the style the list is already using,
so '(a)' and 'a)' start two lists while '(iv)' and '(v)' continue one.
"""
    opened = list_marker(other)
    if opened is None:
        return list_marker(bullet) is None and bullet == other

    delimiter, counter, _ = opened
    here = list_marker(bullet, counter)
    return here is not None and here[0] == delimiter


###########################################
def as_list(value):
    """as_list(object) -> list

Wraps a lone metadata value in a list, so that 'author: X' and a YAML list of
authors can be handled the same way.
"""
    if value is None or value == '':
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    return [value]


def as_bool(value, default=False):
    """as_bool(object, bool) -> bool

Reads a metadata flag.  YAML gives us a real boolean, but -V on the command
line can only give a string, so 'false' and friends have to be understood
rather than taken as a non-empty and therefore true string.
"""
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() not in ('', 'false', 'no', 'off', '0')
    return bool(value)


###########################################
def build_variables(meta, slides):
    """build_variables(dict, str) -> dict

Turns the document metadata into the substitution mapping for the template.

Every variable the shipped template mentions is guaranteed to be present, so
that no '$name' can leak into the LaTeX output.  Metadata keys are passed
through as they are, which lets a custom template use anything from the
metadata block.
"""
    variables = dict(TEMPLATE_DEFAULTS)

    for key, value in meta.items():
        if value is None:               # e.g. a bare 'logo:' with no value
            continue
        if key in JOINED_WITH_AND:
            value = ' \\and '.join(str(item) for item in as_list(value))
        elif isinstance(value, (list, tuple)):
            value = '\n'.join(str(item) for item in value)
        variables[key] = value
        if '-' in key:
            # string.Template only recognizes identifiers, so
            # 'header-includes' has to be reachable as '$headerincludes'
            variables[key.replace('-', '')] = value

    # Options for \documentclass, as one string: an empty one would leave a
    # stray comma behind, which LaTeX complains about.
    options = ['dvipsnames']
    if meta.get('fontsize'):
        options.append(str(meta['fontsize']))
    if meta.get('aspectratio'):
        options.append('aspectratio=%s' % meta['aspectratio'])
    options.extend(str(option) for option in as_list(meta.get('classoption')))
    variables['classoptions'] = ','.join(options)

    # A short form the deck gives explicitly is kept even when it is empty:
    # 'short-institute: ""' is how you say "leave the affiliation out of the
    # footline", and falling back to the long form there would do the
    # opposite of what it asks.  A key present with no value at all
    # ('short-institute:') counts as not given, since YAML reads it as None.
    supplied = set()
    for key, value in meta.items():
        if value is not None:
            supplied.add(key.replace('-', ''))

    for short, long in SHORT_FORMS:
        if short not in supplied:
            variables[short] = variables[long] if long else ''

    # A title page, unless the deck has no title to put on one or asks not
    # to have it.  The template cannot decide this itself: string.Template
    # has no conditionals, so the choice is made here and the variable is
    # either the frame or nothing at all.
    if as_bool(meta.get('titlepage'), bool(variables['title'])):
        variables['titlepage'] = '\\frame{\\titlepage}'
    else:
        variables['titlepage'] = ''

    # A separator slide for every section, on by default as in pandoc: a deck
    # with no sections registers hooks that never fire, so it costs nothing.
    if as_bool(meta.get('section-titles'), True):
        variables['sectionpages'] = SECTION_PAGE_HOOKS
    else:
        variables['sectionpages'] = ''

    # One page per frame: \pausex is defined in terms of \xpause, so
    # emptying the one silences both and the overlays collapse.  Overlay
    # specifications written out by hand ('<2->') are untouched; beamer's own
    # 'classoption: handout' is the blunter instrument for those.
    if as_bool(meta.get('handout'), False):
        variables['handout'] = '\\renewcommand{\\xpause}{}'
    else:
        variables['handout'] = ''

    # A table of contents, off by default -- it is only worth a slide once
    # the deck has sections to list.
    if as_bool(meta.get('toc'), False):
        # 'toc-title' cannot be a template variable of its own: the hyphen is
        # not an identifier, so string.Template could never reach it.
        variables['toc'] = ('\\begin{frame}\n\\frametitle{%s}\n'
                            '\\tableofcontents\n\\end{frame}'
                            % (meta.get('toc-title') or DEFAULT_TOC_TITLE))
    else:
        variables['toc'] = ''

    variables['slides'] = slides
    return variables


###########################################
def parse_image_attributes(text):
    """parse_image_attributes(str) -> (dict, [str])

Parses an image's attribute list into keyed values and bare flags:

    'width=0.8 clip'  ->  ({'width': '0.8'}, ['clip'])

Pandoc classes and identifiers ('.plain', '#fig') are accepted and
discarded: \\includegraphics has nowhere to put them.
"""
    values, flags = {}, []

    position = 0
    text = (text or '').strip()
    while position < len(text):
        match = IMAGE_ATTRIBUTE_RE.match(text, position)
        if not match or match.end() == position:
            break                           # not an attribute list after all
        position = match.end()
        if match.group('key'):
            values[match.group('key')] = match.group('value').strip('\'"')
        elif not match.group('flag').startswith(('.', '#')):
            flags.append(match.group('flag'))

    return values, flags


###########################################
def split_directive_arguments(arguments):
    """split_directive_arguments(str) -> (overlay, kind, text)

Splits a directive's arguments into a beamer overlay specification and the
rest, and says how the rest is to be read:

    ''                  ->  ('',      'none',     '')
    '<2-> Results'      ->  ('<2->',  'friendly', 'Results')
    '[Pumping lemma]'   ->  ('',      'latex',    '[Pumping lemma]')
    '0.3'               ->  ('',      'friendly', '0.3')

'latex' arguments are handed to LaTeX exactly as written, which is what
makes an environment we have never heard of usable; 'friendly' ones are a
width or a title, and get interpreted.
"""
    arguments = arguments.strip()

    overlay = ''
    match = OVERLAY_RE.match(arguments)
    if match:
        overlay = match.group(1)
        arguments = arguments[match.end():].strip()

    if not arguments:
        return overlay, 'none', ''
    if arguments[0] in '[{<':
        return overlay, 'latex', arguments
    return overlay, 'friendly', arguments


###########################################
def parse_one_block(source):
    """parse_one_block(Source) -> BlockElement or None

Parses a single block, the way marko's own parse_source() does one turn of
its loop.  A container that ends at a marker of its own cannot use
parse_source(), which keeps going until no element matches at all.
"""
    elements = sorted(
        (element for element in source.parser.block_elements.values()
         if not element.virtual),
        key=lambda element: element.priority, reverse=True)

    for element in elements:
        if element.match(source):
            result = element.parse(source)
            if not hasattr(result, 'priority'):
                # parse() may return the arguments for the constructor
                # rather than the element itself
                result = element(result)
            return result

    return None


###########################################
class MathDisplay(marko.inline.InlineElement):
    """Display maths, '$$ ... $$'."""

    # above Math, so that '$$' is not read as an empty inline '$$'
    priority = 9
    pattern = re.compile(r'(?<!\\)\$\$([\s\S]+?)(?<!\\)\$\$')
    parse_children = False


class LatexMathDisplay(marko.inline.InlineElement):
    """Display maths in LaTeX's own spelling, '\\[ ... \\]'.

Claimed for the same reason '$$...$$' is: so that Markdown never looks
inside.  Left to marko the '\\[' is an escaped bracket, a Literal whose
backslash render_literal() then drops -- so the maths became prose, silently,
and the contents were parsed as Markdown on the way.  That the renderer
*emits* this spelling for display maths made it worse: its own output was not
valid input to it.
"""

    priority = 9
    pattern = re.compile(r'(?<!\\)\\\[([\s\S]+?)(?<!\\)\\\]')
    parse_children = False


class LatexMath(marko.inline.InlineElement):
    """Inline maths in LaTeX's own spelling, '\\( ... \\)'.

As LatexMathDisplay, and like '$...$' it does not cross a newline, so an
unclosed one cannot run away with the rest of the paragraph.
"""

    priority = 9
    pattern = re.compile(r'(?<!\\)\\\(([^\n]+?)(?<!\\)\\\)')
    parse_children = False


class Math(marko.inline.InlineElement):
    """Inline maths, '$ ... $'.

Claimed before emphasis, which is what keeps '$pc_1 \\land pc_2$' intact:
left to marko those underscores would pair up into emphasis.  A newline ends
the search, so a stray '$' cannot run away with the rest of the paragraph.

The opening '$' may be neither preceded nor followed by another, so that a
'$$' opener is left to MathDisplay.  Without that, finditer() matched from
the *second* '$' of the opener and then again from the second '$' of the
closer, and that second match -- '$' plus whatever followed the display --
ran past the real inline maths after it.  The bogus token was dropped as
overlapping MathDisplay, but the region had been consumed, so the real maths
never got a token at all and its underscores became emphasis.  Two inline
spans written with nothing between them ('$x_1$$y_2$') are the cost: the
first is claimed, the second is left to pass through as text, which LaTeX
still typesets correctly.
"""

    priority = 8
    pattern = re.compile(r'(?<![\\$])\$(?!\$)((?:[^$\n\\]|\\.)+?)(?<!\\)\$')
    parse_children = False


class Graphic(marko.inline.InlineElement):
    """An image, claimed together with its attribute list.

Left to marko the '{ width=0.8 }' would be parsed separately as text and
end up in the output as a stray group next to \\includegraphics.

The title, '![](f.png "ignored")', has nowhere to go in LaTeX and is
dropped, as pandoc drops it; a caption comes from the alt text instead.
"""

    priority = 8
    pattern = IMAGE_RE
    # The whole image is claimed, but only the alt text becomes children, so
    # a caption may hold Markdown just as a directive's title may.
    parse_children = True
    parse_group = 'alt'

    def __init__(self, match):
        self.alt = match.group('alt')       # the raw text, to test emptiness
        self.dest = match.group('dest')
        self.title = match.group('title') or ''
        self.values, self.flags = parse_image_attributes(match.group('attrs'))


class Highlight(marko.inline.InlineElement):
    """Highlighted text, '==like this=='.

Becomes a call to the macro named by the 'highlight' metadata key, `\\hlbl`
by default.  The delimiters may not sit against whitespace, as with '**', and
a run of three or more '=' is left alone so that a setext heading underline
is never mistaken for one.
"""

    # above emphasis, so that '==**x**==' nests the right way round; below
    # code spans and maths, so that '$a == b$' is left alone
    priority = 6
    pattern = re.compile(r'(?<![=\\])==(?![=\s])((?:[^=]|=(?!=))+?)(?<!\s)==(?!=)')
    parse_children = True


class Span(marko.inline.InlineElement):
    """A bracketed span with attributes, '[text]{.hlrd}'.

Each class becomes a macro wrapped around the text, so the class *is* the
macro name and any macro of your own works without being registered.  With
several, the first ends up outermost.
"""

    # above the link parser, or '[text]{...}' would be read as a link label
    priority = 7
    # The text may cross a line break, since prose is wrapped and a span is
    # no more willing to be split than emphasis is.  Only a paragraph's own
    # text is ever searched, so there is no blank line to run past.  The ']'
    # and the '{' stay adjacent, which is what keeps '[text](url) {x}' from
    # being read as one of these.
    pattern = re.compile(r'\[((?:[^\[\]]|\\.)+)\]\{([^{}\n]*)\}')
    parse_children = True
    parse_group = 1

    def __init__(self, match):
        self.attributes = match.group(2)


class RawLatexInline(marko.inline.InlineElement):
    """A LaTeX macro call in the middle of a sentence, '\\hlbl{...}'.

Claimed as a whole so that Markdown never looks inside the arguments, where
an underscore or an asterisk would otherwise be taken as markup.
"""

    priority = 8
    pattern = re.compile(MACRO)
    parse_children = False
    parse_group = 0             # the pattern has no capturing group


class List(marko.block.List):
    """An ordered list, which may be lettered, roman, or start where it likes.

marko's own knows '1.' and '1)' and nothing else, so '(a)' was a paragraph
beginning with a bracket.  Widening the marker here keeps the rest of marko's
list machinery -- continuations, nesting, tight versus loose -- which is the
part worth not reimplementing.
"""

    override = True
    pattern = LIST_MARKER_RE

    @classmethod
    def match(cls, source):
        match = source.expect_re(cls.pattern)
        if not match:
            return False

        bullet = match.group(1)
        marker = list_marker(bullet)
        source.context.list_info = cls.ParseInfo(
            bullet, marker is not None, marker[2] if marker else 1)
        return True


class ListItem(marko.block.ListItem):
    """An item of one.

Same widening, and the test for whether an item belongs to the list above it
becomes "written the same way" rather than marko's "both end in the same
punctuation": '(a)' and 'a)' are two lists, not one.
"""

    override = True
    pattern = LIST_MARKER_RE

    @classmethod
    def match(cls, source):
        if source.parser.block_elements['ThematicBreak'].match(source):
            return False
        if not source.expect_re(cls.pattern):
            return False

        line = source.next_line(False).expandtabs(4)
        prefix = re.match(source.prefix, line)
        indent, bullet, mid, _ = cls.parse_leading(
            line.rstrip(), prefix.end() if prefix else 0)

        if not same_list_family(bullet, source.state.bullet):
            return False

        source.context.list_item_info = cls.ParseInfo(indent, bullet, mid)
        return True


class Paragraph(marko.block.Paragraph):
    """A paragraph, which a list may interrupt.

CommonMark lets a list interrupt a paragraph only when it starts at one,
so that a sentence ending in a year does not become a list.  marko tests
that by looking at the marker: it has to be written '1'.  Ours may be
written '(a)' or '(i)', which is the same thing said another way, and
without this a nested lettered list under an item was swallowed into the
item's own text.

Only the case marko declines is added; everything else is still its
decision, which keeps the amount of its block loop living here to a
minimum.
"""

    override = True

    @classmethod
    def break_paragraph(cls, source, lazy=False):
        if super().break_paragraph(source, lazy):
            return True

        previous = source.match
        try:
            if not source.parser.block_elements['List'].match(source):
                return False
            _, bullet, _, tail = source.parser.block_elements[
                'ListItem'].parse_leading(source.next_line().rstrip(), 0)
            marker = list_marker(bullet)
            return bool(marker and marker[2] == 1 and tail)
        finally:
            source.match = previous


###########################################
class SlideMetadata(marko.block.BlockElement):
    """A slide's own metadata block, '---' to '---'.

Starts a frame and says what that frame is: its title, its options, its
label.  The heading form is the shorthand -- '# Why it grows {#growth}' and a
block giving title and label are the same slide -- and this is what a frame
with no heading at all had no way to say.

Priority 9 puts it above marko's ThematicBreak, which would otherwise claim
the '---'.  It only matches when a closing fence follows, so a lone '---' is
still a break.
"""

    priority = 9

    #: what match() read, for parse() to use: claiming the block is decided
    #: by whether the YAML is usable, so it has to be parsed to decide
    _meta = None

    def __init__(self, meta):
        self.meta = meta
        self.children = []

    @classmethod
    def match(cls, source):
        # Only at the top level.  Source.expect_re matches the raw buffer, so
        # inside a quote or a list item the lines still carry the container's
        # prefix and the match would run straight through its end.
        if source.state is not source.root:
            return None

        match = source.expect_re(SLIDE_METADATA_RE)
        if not match:
            return None

        # A block is claimed only when it says something this tool
        # understands.  Anything else -- prose that happens to be
        # 'Note: this', a YAML comment -- is text below a '===' line, and has
        # to stay text.
        meta = load_slide_metadata(match.group(1))
        if not meta:
            return None

        cls._meta = meta
        return match

    @classmethod
    def parse(cls, source):
        source.expect_re(SLIDE_METADATA_RE)
        source.consume()
        meta, cls._meta = cls._meta, None
        return parse_slide_metadata(meta, source)


###########################################
def load_slide_metadata(text):
    """load_slide_metadata(str) -> dict or None

Reads the YAML between a slide block's fences, and says whether this is a
slide block at all.

None means it is not: the text is not a mapping, or names nothing this tool
understands.  Deciding it here, before the block is claimed, keeps prose that
happens to parse as a mapping from being read as settings -- a page about
YAML, say, whose lines really are 'key: value'.
"""
    try:
        meta = yaml.safe_load(text)
    except yaml.YAMLError:
        return None

    if not isinstance(meta, dict) or not meta:
        return None
    if not any(key in SLIDE_METADATA_KEYS for key in meta):
        return None

    return meta


###########################################
def parse_slide_metadata(meta, source):
    """parse_slide_metadata(dict, Source) -> dict

Finishes a slide's metadata once the block has been claimed.  A title is
parsed as Markdown here rather than at render time, the way a directive's is,
so that '**bold**' and '$x$' work in it exactly as they do in a heading.
"""
    named = ', '.join(sorted(str(key) for key in meta
                             if key in SLIDE_METADATA_KEYS))

    for key in meta:
        if key not in SLIDE_METADATA_KEYS:
            print("%s: warning: a slide has no '%s' setting (in the block "
                  "setting %s)" % (PROG, key, named), file=sys.stderr)

    for key in ('title', 'part', 'section', 'subsection'):
        if key in meta:
            # a title may be a number, a date, anything YAML reads as a scalar
            meta[key] = markdown_value(scalar(meta[key]), source.parser)

    return meta


###########################################
def itemsep_lengths(value):
    """itemsep_lengths(object) -> [str] or None

The 'itemsep:' of a slide, as one length per nesting level.

A lone value applies to every level, which is what it has always meant.  A
list gives the first, second, third and so on, and the last entry stands for
everything deeper -- so a two-item list does not leave a list nested three
deep unset, it gives it the second value.
"""
    if value is None:
        return None
    lengths = [length(item) for item in as_list(value)]
    return lengths or None


###########################################
def length(value):
    """length(object) -> str or None

A length from a slide's metadata.  A bare number is read as 'em', the way a
bare number is a fraction of \\textwidth for '@column' -- 'itemsep: 0' is the
natural way to close a list up, and '\\setlength{\\itemsep}{0}' is an
'Illegal unit' error rather than a tight list.
"""
    if value is None:
        return None
    text = scalar(value)
    return text + 'em' if BARE_NUMBER_RE.match(text) else text


###########################################
def scalar(value):
    """scalar(object) -> str

A metadata value as a single line of text.  YAML hands back numbers, dates
and lists as readily as strings, and a newline inside \\begin{frame}{...}
is not something LaTeX forgives.
"""
    if isinstance(value, (list, tuple)):
        value = ' '.join(str(item) for item in value)
    return ' '.join(str(value).split())


###########################################
def render_metadata(markdown, meta):
    """render_metadata(Markdown, dict) -> None

Parses the metadata values that become prose on a slide as Markdown, in
place, so that a title can be written '**Lecture 7**' rather than
'\\textbf{Lecture 7}'.  It is the same answer a slide's own 'title:' gives,
and the two have to agree: a heading moved into a metadata block must not
quietly lose its emphasis.

LaTeX in those values goes on working, since passthrough is what happens to
anything Markdown does not claim.  What changes is that an underscore in a
title is now emphasis, as it already was in a heading.
"""
    for key in MARKDOWN_METADATA:
        value = meta.get(key)
        if isinstance(value, str):
            meta[key] = render_metadata_value(markdown, value)
        elif isinstance(value, (list, tuple)):
            # 'author:' may be a list, and each of them is prose
            meta[key] = [render_metadata_value(markdown, item)
                         if isinstance(item, str) else item for item in value]


###########################################
def render_metadata_value(markdown, text):
    """render_metadata_value(Markdown, str) -> str

Renders one metadata value.  Only a value that parses as a single paragraph
is taken: '1. Introduction' is a numbered title, not a list, and rendering
the document it parses as would make one of it.  Anything block-shaped is
handed back as the string it was, which is what every value used to be.
"""
    if '\\' in text:
        # A backslash says this value is LaTeX, and LaTeX is what passthrough
        # hands over untouched.  Parsing it would cost a deck its line breaks:
        # marko reads the '\\\\' of 'Lecture 7\\\\Symbolic Execution' as one
        # escaped backslash and renders a single one, which is not a break.
        return text

    blocks = markdown.parse(text).children
    if len(blocks) != 1 or blocks[0].get_type() != 'Paragraph':
        return text
    if lone_graphic(blocks[0]) is not None:
        return text                     # a caption belongs on no title page

    # the paragraph alone, not the document: render_document() would wrap it
    # in a frame
    return markdown.render(blocks[0]).strip()


###########################################
def markdown_value(text, parser):
    """markdown_value(str, Parser) -> [Element] or str

Parses a metadata value as Markdown, and hands back the blocks to render.

Only a value that parses as a single paragraph is taken: '1. Introduction' is
a numbered title, not a list, and parsing it as a document would make one of
it.  Anything block-shaped is returned as the string it was, which is what
every metadata value used to be.
"""
    blocks = parser.parse(text).children
    if len(blocks) == 1 and blocks[0].get_type() == 'Paragraph':
        return blocks
    return text


###########################################
class RawLatexEnvironment(marko.block.BlockElement):
    """A LaTeX environment, '\\begin{tabularx}' to '\\end{tabularx}'.

Everything in between is taken verbatim, which is what lets a table with its
'&' and '\\\\' sit in the middle of a slide.  Left to Markdown, '\\\\' would be
read as an escaped backslash and lose one of them.

This does break a paragraph: a '\\begin{...}' at the start of a line is a
block by any reading, and the deck has one directly below a ':::' line with
no blank line in between.
"""

    priority = 9
    breaks_paragraph = True

    def __init__(self, text):
        self.text = text
        self.children = []

    @classmethod
    def match(cls, source):
        return source.expect_re(BEGIN_ENV_RE)

    @classmethod
    def parse(cls, source):
        first = source.next_line()
        source.consume()

        name = BEGIN_ENV_RE.match(first).group(1)
        environment = re.escape(name)
        begin = re.compile(r'\\begin\{' + environment + r'\}')
        end = re.compile(r'\\end\{' + environment + r'\}')

        # A heading is a frame boundary and no environment reaches past one.
        # Without this an unterminated '\begin{...}' swallowed the rest of the
        # file: every later heading became literal text inside it, and a deck
        # of twenty frames came out as one.  Verbatim environments are exempt,
        # since a '# ' line in one is a shell or Python comment.  ('#include'
        # is safe either way: an ATX heading needs a space after the hashes.)
        stops_at_heading = name not in VERBATIM_ENVIRONMENTS

        # count nesting, so that an inner tabular of the same kind does not
        # end the outer one early
        lines, depth = [first], 1
        while not source.exhausted and depth > 0:
            line = source.next_line()
            if line is None:
                break                       # unterminated; take what we have
            if stops_at_heading and HEADING_LINE_RE.match(line):
                break                       # not ours to eat: leave it parsed
            source.consume()
            lines.append(line)
            depth += len(begin.findall(line)) - len(end.findall(line))

        if depth > 0:
            print("%s: warning: '\\begin{%s}' was never closed"
                  % (PROG, name), file=sys.stderr)

        return ''.join(lines).rstrip('\n')


class RawLatexMacroLine(marko.block.BlockElement):
    """A line holding nothing but macro calls, e.g. '\\pausex' or '\\medskip'.

breaks_paragraph is deliberately False, unlike the environment above.  A
'\\pausex' at column 0 in the middle of a list should stay with the item it
follows, as a lazy continuation line, rather than tearing the list in two.
"""

    priority = 9
    breaks_paragraph = False

    def __init__(self, text):
        self.text = text
        self.children = []

    @classmethod
    def match(cls, source):
        if source.expect_re(BEGIN_ENV_RE):
            return None                     # RawLatexEnvironment's business
        return source.expect_re(MACRO_LINE_RE)

    @classmethod
    def parse(cls, source):
        line = source.next_line()
        source.consume()
        return line.strip()


class Directive(marko.block.BlockElement):
    """An environment written as '@name arguments', closed by '@end'.

The body is parsed as Markdown, which is the whole point of having this
alongside \\begin{...}: the two syntaxes say what should happen to the
contents, so no list of environment names has to decide it.

    @column 0.3                 @theorem[Pumping lemma]
    * **Markdown** in here      For every **regular** language ...
    @column 0.7                 @end
    ...
    @end columns

Three things close a directive: an '@end', optionally naming what it
closes; the same name again, for the directives that come in rows, so a
column needs no '@end' before the next one; and a heading, since no
environment should reach past the end of its frame.  An '@end name' closes
anything still open inside it, the way </ul> does in HTML.
"""

    priority = 9
    breaks_paragraph = True

    def __init__(self, info):
        (self.name, self.overlay, self.kind, self.text,
         self.title, self.children) = info

    @classmethod
    def match(cls, source):
        if source.expect_re(DIRECTIVE_END_RE):
            return None                     # StrayDirectiveEnd's business
        return source.expect_re(DIRECTIVE_RE)

    @classmethod
    def parse(cls, source):
        match = source.expect_re(DIRECTIVE_RE)
        name = match.group('name')
        overlay, kind, text = split_directive_arguments(match.group('args'))
        source.next_line()
        source.consume()

        title = []
        if kind == 'friendly' and name not in WIDTH_DIRECTIVES:
            # a title may hold Markdown, '@block Results **so far**'
            title = source.parser.parse(text).children

        children = []
        while not source.exhausted:
            line = source.next_line()
            if line is None:
                break                       # left the enclosing container

            end = DIRECTIVE_END_RE.match(line)
            if end:
                if end.group('name') in (None, name):
                    source.consume()        # ours; a bare @end closes here
                break                       # otherwise an enclosing one's

            sibling = DIRECTIVE_RE.match(line)
            if sibling and name in SIBLING_DIRECTIVES \
                    and sibling.group('name') == name:
                break                       # closed by the next of its kind

            if HEADING_LINE_RE.match(line):
                break                       # closed by the frame boundary

            block = parse_one_block(source)
            if block is None:
                break
            children.append(block)

        return name, overlay, kind, text, title, children


class StrayDirectiveEnd(marko.block.BlockElement):
    """An '@end' with nothing open; reported and dropped rather than printed."""

    priority = 9
    breaks_paragraph = True

    def __init__(self, text):
        self.text = text
        self.children = []

    @classmethod
    def match(cls, source):
        return source.expect_re(DIRECTIVE_END_RE)

    @classmethod
    def parse(cls, source):
        line = source.next_line()
        source.consume()
        return line.strip()


###########################################
def markdown_extension():
    """markdown_extension() -> marko.helpers.MarkoExtension

The elements above, as an extension to register with marko.
"""
    return marko.helpers.MarkoExtension(
        elements=[MathDisplay, LatexMathDisplay, LatexMath, Math, Graphic,
                  Span, Highlight, RawLatexInline,
                  RawLatexEnvironment, RawLatexMacroLine, SlideMetadata,
                  List, ListItem, Paragraph,
                  Directive, StrayDirectiveEnd])


###########################################
def escape_latex(text):
    """escape_latex(str) -> str

Escapes the characters LaTeX treats specially.  Only used where the text is
meant to be taken literally, i.e. inside `inline code'.
"""
    return ''.join(LATEX_ESCAPES.get(char, char) for char in text)


###########################################
def escape_url(url):
    """escape_url(str) -> str

Makes a URL safe as the argument of \\href, which is read as an ordinary
macro argument: a '#' in it is taken for a parameter, and LaTeX answers
'Illegal parameter number in definition of \\iterate' and loses the frame.

Braces are percent-encoded rather than backslash-escaped, since a brace has
to be balanced to survive being read as an argument at all.  '&', '_' and
'~' are left alone, which is what pandoc does and what hyperref copes with.
"""
    return ''.join(URL_ESCAPES.get(char, char) for char in url)


###########################################
def heading_level(element):
    """heading_level(Element) -> int or None

The level of a heading element, or None if it is not a heading.
"""
    if element.get_type() in ('Heading', 'SetextHeading'):
        return element.level
    return None


###########################################
def split_heading_attributes(title):
    """split_heading_attributes(str) -> (str, [str], str or None)

Splits a trailing attribute list off a frame title, returning the title, the
frame options it asks for, and the sectioning level it opens, if any:

    'Algorithm {.fragile}'  ->  ('Algorithm', ['fragile'], None)
    'Part II {.section}'    ->  ('Part II',   [],          'section')
"""
    match = HEADING_ATTRS_RE.search(title)
    if not match:
        return title, [], None

    options, sectioning = [], None
    for token in match.group(1).split():
        if token.startswith('.') and token[1:] in SECTIONING_CLASSES:
            sectioning = token[1:]
        elif token.startswith('.') and token[1:] in FRAME_OPTIONS:
            options.append(token[1:])
        elif '=' in token:
            options.append(token)
        elif token.startswith('#'):
            options.append('label=%s' % token[1:])

    return title[:match.start()].rstrip(), options, sectioning


###########################################
def lone_graphic(paragraph):
    """lone_graphic(Paragraph) -> Graphic or None

The one image a paragraph consists of, if that is all it holds apart from
whitespace.  Such an image is a figure rather than something in a sentence.
"""
    found = None

    for child in paragraph.children:
        kind = child.get_type()
        if kind == 'Graphic':
            if found is not None:
                return None                 # more than one
            found = child
        elif kind == 'LineBreak':
            continue
        elif kind == 'RawText' and not child.children.strip():
            continue
        else:
            return None                     # prose alongside the image

    return found


###########################################
def contains_verbatim(elements):
    """contains_verbatim([Element]) -> bool

Whether anything in the subtree is typeset verbatim.  Beamer needs
[fragile] on a frame that holds a listing, because it has to read the frame
body twice.
"""
    for element in elements:
        kind = element.get_type()
        if kind in ('FencedCode', 'CodeBlock'):
            return True
        if kind in ('RawLatexEnvironment', 'RawLatexMacroLine') \
                and VERBATIM_RE.search(element.text):
            return True
        if kind == 'RawLatexInline' and VERBATIM_RE.search(element.children):
            return True
        children = getattr(element, 'children', None)
        if children and not isinstance(children, str) \
                and contains_verbatim(children):
            return True
    return False


###########################################
class BeamerRenderer(marko.Renderer):
    """Renders a parsed Markdown document as the body of a Beamer document.

Prose is passed through to LaTeX untouched: whatever marko does not
recognize as Markdown is assumed to be LaTeX and left alone.  That is what
lets \\hlbl{...} and \\ldots work in the middle of a sentence.  Escaping only
happens inside `inline code', where the text is meant to be literal.
"""

    #: heading level that starts a new frame; set by make_markdown()
    slide_level = 1

    #: escape character for ```lstlisting fences; set by make_markdown()
    escapechar = LISTINGS_ESCAPECHAR

    #: colours for links, '' for none; set by make_markdown()
    url_color = DEFAULT_URL_COLOR
    link_color = DEFAULT_URL_COLOR

    #: the macro '==...==' becomes; set by make_markdown()
    highlight = DEFAULT_HIGHLIGHT

    #: whether '"' becomes a typographic quote; set by make_markdown()
    smart = True

    #: the last character rendered, so that a quote opening a span of
    #: emphasis can still tell what came before it
    _previous = ''

    #: 'itemsep:' from the slide being rendered, one length per nesting
    #: level, or None
    _itemsep = None

    #: how many lists deep the renderer is, so that itemsep can tell the
    #: levels apart
    _list_depth = 0

    #: how many *ordered* lists deep, which is a different number: LaTeX
    #: counts its enumerate levels among themselves, so an enumerate inside
    #: a bullet list is still the first of them and counts with enumi
    _enum_depth = 0

    ####################
    # document structure
    ####################

    def render_document(self, element):
        self._previous = ''             # marko reuses the renderer instance
        self._itemsep = None
        self._list_depth = 0
        self._enum_depth = 0
        parts = []
        for kind, heading, nodes, meta in self.split_slides(element.children):
            if kind == 'section':
                title, _, sectioning = split_heading_attributes(
                    self.render_children(heading))
                # a heading above the slide level is a section already; a
                # sectioning class on it only says which level
                parts.append('\\%s{%s}\n' % (sectioning or 'section', title))
            else:
                parts.append(self.render_frame(heading, nodes, meta))
        return '\n'.join(parts)

    def split_slides(self, children):
        """split_slides([Element]) -> [(str, Element or None, [Element], dict)]

Groups the top level of the document into sections and frames.  A heading
above the slide level becomes a \\section, one at the slide level starts a
frame, a slide metadata block starts a frame and says what it is, and a
thematic break starts a frame with no title.
"""
        slides = []
        frame = None

        for child in children:
            level = heading_level(child)
            if level is not None and level < self.slide_level:
                slides.append(('section', child, [], {}))
                frame = None
            elif level == self.slide_level:
                frame = []
                slides.append(('frame', child, frame, {}))
            elif child.get_type() == 'SlideMetadata':
                frame = []
                slides.append(('frame', None, frame, child.meta))
            elif child.get_type() == 'ThematicBreak':
                frame = []
                slides.append(('frame', None, frame, {}))
            elif frame is None:
                # material before the first heading: skip the blank lines
                # left behind by the metadata block, keep anything else
                if child.get_type() == 'BlankLine':
                    continue
                frame = [child]
                slides.append(('frame', None, frame, {}))
            else:
                frame.append(child)

        return slides

    def render_frame(self, heading, nodes, meta=None):
        """render_frame(Element or None, [Element], dict) -> str"""
        meta = meta or {}
        options = []
        title = ''
        separator_title = None
        sectioning = None
        if heading is not None:
            title, options, sectioning = split_heading_attributes(
                self.render_children(heading))

        # The block form of the same three things.  A heading and a block
        # never describe one frame -- a heading starts a frame of its own --
        # so these cannot disagree with what was read above.
        if 'title' in meta:
            title = self.metadata_value(meta['title'])
        for level in ('part', 'section', 'subsection'):
            if level in meta:
                if sectioning:
                    print('%s: warning: a slide opens both a %s and a %s'
                          % (PROG, sectioning, level), file=sys.stderr)
                sectioning = level
                # the level names the divider; 'title:' beside it names the
                # slide that follows, and neither is the other's business
                separator_title = self.metadata_value(meta[level])
        if 'options' in meta:
            options = [scalar(option) for option in as_list(meta['options'])]
        if 'label' in meta:
            options.append('label=%s' % scalar(meta['label']))

        separator = ''
        if sectioning:
            title, separator_title = (separator_title or title), None
            # Only open the sectioning level; the separator slide itself is
            # hooked onto it in the preamble, by $sectionpages, so that
            # 'section-titles: false' can switch every one of them off and a
            # section made by a heading above the slide level gets one too.
            separator = '\\%s{%s}\n' % (sectioning, title)
            if not any(node.get_type() != 'BlankLine' for node in nodes):
                return separator            # nothing else on this slide

        if contains_verbatim(nodes) and 'fragile' not in options:
            options.insert(0, 'fragile')

        head = '\\begin{frame}'
        if options:
            head += '[%s]' % ','.join(options)
        if title:
            head += '{%s}' % title

        # Set on the renderer rather than threaded through every block, so
        # that a list nested in a directive or a column is reached too.  Put
        # back afterwards: it is this frame's business and no other's.
        previous = self._itemsep
        self._itemsep = itemsep_lengths(meta.get('itemsep'))
        body = ''.join(self.render(node) for node in nodes)
        self._itemsep = previous

        return '%s%s\n%s\\end{frame}\n' % (separator, head, body)

    def metadata_value(self, value):
        """metadata_value([Element] or str) -> str

A slide's title, as Markdown where it parsed as Markdown.
"""
        if isinstance(value, str):
            return value
        return ''.join(self.render(block) for block in value).strip()

    ####################
    # blocks
    ####################

    def render_paragraph(self, element):
        # an image alone in a paragraph, with alt text, is a captioned
        # figure; otherwise the alt text would be dropped on the floor
        # a new paragraph starts a new line as far as quotes are concerned,
        # or the last word of the one above decides how the first one leans
        self._previous = '\n'

        graphic = lone_graphic(element)
        if graphic is not None and graphic.alt.strip():
            return ('\\begin{figure}\n\\centering\n%s\n\\caption{%s}\n'
                    '\\end{figure}\n'
                    % (self.render(graphic), self.render_children(graphic)))

        text = self.render_children(element)
        return text + ('\n' if element._tight else '\n\n')

    def render_blank_line(self, element):
        return ''

    def render_line_break(self, element):
        return '\n' if element.soft else '\\\\\n'

    def render_list(self, element):
        environment = 'enumerate' if element.ordered else 'itemize'
        # A list whose items are single paragraphs is set tight, the way
        # pandoc does it; otherwise beamer leaves a gap between every item.
        tight = '\\tightlist\n' if getattr(element, 'tight', False) else ''

        # Depth counts every list, not every itemize, so an enumerate inside
        # an itemize is the second level -- which is what it looks like on
        # the slide, and beamer sets it with the second-level template.
        self._list_depth += 1
        if element.ordered:
            self._enum_depth += 1
        # 'itemsep:' on the slide.  After \tightlist, which zeroes it, and
        # inside the environment, since itemize resets \itemsep on entry.
        itemsep = self.itemsep_at(self._list_depth)
        if itemsep is not None:
            tight += '\\setlength{\\itemsep}{%s}\n' % itemsep

        # What the author wrote the first marker as is what the list looks
        # like: beamer reads an enumerate's optional argument as the template
        # for its labels, and '(a)' is that template already.  The plain '1.'
        # is left without one, so that every deck written before this renders
        # exactly as it did.
        options = ''
        marker = list_marker(element.bullet) if element.ordered else None
        if marker is not None:
            delimiter, counter, start = marker
            if (delimiter, counter) != ('%s.', '1'):
                options = '[%s]' % (delimiter % counter)
            if start != 1 and self._enum_depth <= len(ENUM_COUNTERS):
                # \setcounter, not a package: the counter is one behind the
                # first \item, and LaTeX has one per enumerate level
                tight += '\\setcounter{%s}{%d}\n' % (
                    ENUM_COUNTERS[self._enum_depth - 1], start - 1)

        try:
            body = self.render_children(element)
        finally:
            self._list_depth -= 1
            if element.ordered:
                self._enum_depth -= 1

        return '\\begin{%s}%s\n%s%s\\end{%s}\n' % (
            environment, options, tight, body, environment)

    def itemsep_at(self, level):
        """itemsep_at(int) -> str or None

The 'itemsep:' for a list at this nesting level, the last one given
standing for every level below those named.
"""
        if not self._itemsep:
            return None
        return self._itemsep[min(level, len(self._itemsep)) - 1]

    def render_list_item(self, element):
        body = self.render_children(element).lstrip()
        if not body.strip():
            return '\\item\n'
        return '\\item %s' % (body if body.endswith('\n') else body + '\n')

    def render_quote(self, element):
        return '\\begin{quote}\n%s\\end{quote}\n' % self.render_children(element)

    def render_fenced_code(self, element):
        return self.render_listing(element.lang, element.children[0].children)

    def render_code_block(self, element):
        return self.render_listing('', element.children[0].children)

    def render_listing(self, language, code):
        """render_listing(str, str) -> str"""
        options = []
        name = (language or '').strip().lower()

        if name in RAW_LISTING_LANGUAGES:
            # the author is writing listings input, so let the escapes work
            if self.escapechar:
                options.append('escapechar=%s' % self.escapechar)
        elif LISTINGS_LANGUAGES.get(name):
            # braces: a '[dialect]language' value would otherwise break the
            # option parser of listings
            options.append('language={%s}' % LISTINGS_LANGUAGES[name])

        head = '\\begin{lstlisting}'
        if options:
            head += '[%s]' % ','.join(options)
        if not code.endswith('\n'):
            code += '\n'
        return '%s\n%s\\end{lstlisting}\n' % (head, code)

    def render_heading(self, element):
        # A heading below the slide level.  TODO: \begin{block}{...}, which
        # needs the following siblings, not just this element.
        title, _, _ = split_heading_attributes(self.render_children(element))
        return '\\textbf{%s}\\par\n' % title

    def render_setext_heading(self, element):
        return self.render_heading(element)

    def render_thematic_break(self, element):
        # only reached inside a container; at the top level it starts a frame
        return '\\medskip\\hrule\\medskip\n'

    def render_directive(self, element):
        body = self.render_children(element)
        arguments = self.directive_arguments(element)

        if element.name in COMMAND_DIRECTIVES:
            return '\\%s%s{%%\n%s}\n' % (element.name, element.overlay, body)

        return '\\begin{%s}%s%s\n%s\\end{%s}\n' % (
            element.name, element.overlay, arguments, body, element.name)

    def directive_arguments(self, element):
        """directive_arguments(Directive) -> str"""
        if element.kind == 'latex':
            return element.text             # exactly as written
        if element.kind == 'none':
            return DIRECTIVE_DEFAULT_ARGUMENTS.get(element.name, '')

        if element.name in WIDTH_DIRECTIVES:
            if BARE_NUMBER_RE.match(element.text):
                return '{%s\\textwidth}' % element.text
            return '{%s}' % element.text    # a length such as 4cm

        title = ''.join(self.render(block) for block in element.title).strip()
        if element.name in BRACKET_TITLE_DIRECTIVES:
            return '[%s]' % title
        return '{%s}' % title

    def render_stray_directive_end(self, element):
        print("%s: warning: '%s' with nothing open" % (PROG, element.text),
              file=sys.stderr)
        return ''

    def render_slide_metadata(self, element):
        # consumed by split_slides(), which is where a slide is decided
        return ''

    def render_raw_latex_environment(self, element):
        return element.text + '\n'

    def render_raw_latex_macro_line(self, element):
        return element.text + '\n'

    def render_html_block(self, element):
        return ''       # commented-out slides and <!-- notes -->

    def render_link_ref_def(self, element):
        return ''

    ####################
    # inline
    ####################

    def render_raw_text(self, element):
        return self.smarten(element.children)

    def smarten(self, text):
        """smarten(str) -> str

Turns a straight '"' into the LaTeX spelling of a typographic one, ``like
this''.  Whether a quote opens or closes is decided from the character
before it, so the two do not have to be paired up and an odd one cannot
send the rest of the deck the wrong way round.

Only prose passes through here, so quotes in `code`, in maths, in listings
and inside raw LaTeX are left alone without having to be excluded.  A '\\"'
is a Literal and never reaches this either, which is the way out.
"""
        if not self.smart or '"' not in text:
            self._previous = text[-1:] or self._previous
            return text

        out = []
        for char in text:
            if char == '"':
                opens = (self._previous == ''
                         or self._previous in QUOTE_OPENS_AFTER)
                out.append('``' if opens else "''")
            else:
                out.append(char)
            self._previous = char

        return ''.join(out)

    def render_math(self, element):
        return '$%s$' % element.children

    def render_math_display(self, element):
        return '\\[%s\\]' % element.children

    def render_latex_math_display(self, element):
        # back exactly as written: the author asked for this spelling
        return '\\[%s\\]' % element.children

    def render_latex_math(self, element):
        return '\\(%s\\)' % element.children

    def render_raw_latex_inline(self, element):
        return element.children

    def render_literal(self, element):
        char = element.children
        return '\\' + char if char in LATEX_SPECIALS else char

    def render_highlight(self, element):
        return '\\%s{%s}' % (self.highlight, self.render_children(element))

    def render_span(self, element):
        text = self.render_children(element)
        for name in reversed(SPAN_CLASS_RE.findall(element.attributes)):
            text = '\\%s{%s}' % (name, text)   # the first ends up outermost
        return text

    def render_emphasis(self, element):
        return '\\emph{%s}' % self.render_children(element)

    def render_strong_emphasis(self, element):
        return '\\textbf{%s}' % self.render_children(element)

    def render_code_span(self, element):
        return '\\texttt{%s}' % escape_latex(element.children)

    def coloured(self, text, colour):
        """coloured(str, str) -> str: the text, in `colour' if there is one."""
        return '\\textcolor{%s}{%s}' % (colour, text) if colour else text

    def render_link(self, element):
        body = self.render_children(element)
        if element.dest.startswith('#'):
            # '[text](#intro)' pairs with the '{#intro}' heading attribute,
            # which beamer turns into label=intro
            return '\\hyperlink{%s}{%s}' % (
                element.dest[1:], self.coloured(body, self.link_color))
        return '\\href{%s}{%s}' % (escape_url(element.dest),
                                   self.coloured(body, self.url_color))

    def render_auto_link(self, element):
        return self.coloured('\\url{%s}' % escape_url(element.dest),
                             self.url_color)

    def render_image(self, element):
        # a reference-style image, '![alt][ref]', which carries no attributes
        return '\\includegraphics{%s}' % element.dest

    def render_graphic(self, element):
        options = []
        for key, value in element.values.items():
            relative_to = IMAGE_LENGTHS.get(key)
            if relative_to and BARE_NUMBER_RE.match(value):
                value = '%s\\%s' % (value, relative_to)
            options.append('%s=%s' % (key, value))
        options.extend(element.flags)

        graphic = '\\includegraphics'
        if options:
            graphic += '[%s]' % ','.join(options)
        return graphic + '{%s}' % element.dest

    def render_inline_html(self, element):
        return ''


###########################################
class BeamerMarkdown(marko.Markdown):
    """marko.Markdown with the '%' comment lines taken out of the source.

parse() is the hook marko documents for preprocessing the text, and doing it
here rather than in convert() means anything that parses a document gets it,
the tests included.
"""

    def parse(self, text):
        return super().parse(strip_comments(text))


###########################################
def make_markdown(opts, meta=None):
    """make_markdown(argparse.Namespace, dict) -> marko.Markdown

marko instantiates the renderer itself, so the options it needs are handed
over as class attributes of a throwaway subclass.  The metadata comes in
because link colours are a property of the document, not of the run.
"""
    meta = meta or {}

    # 'colorlinks: false' leaves links looking like the prose around them;
    # 'urlcolor'/'linkcolor' choose the colour, as they do in pandoc.
    if as_bool(meta.get('colorlinks'), True):
        url_color = str(meta.get('urlcolor') or DEFAULT_URL_COLOR)
        link_color = str(meta.get('linkcolor') or url_color)
    else:
        url_color = link_color = ''

    renderer = type('_BeamerRenderer', (BeamerRenderer,),
                    {'slide_level': opts.slide_level,
                     'escapechar': opts.escapechar,
                     'url_color': url_color,
                     'link_color': link_color,
                     'highlight': str(meta.get('highlight')
                                      or DEFAULT_HIGHLIGHT),
                     'smart': as_bool(meta.get('smart'), True)})
    return BeamerMarkdown(renderer=renderer,
                          extensions=[markdown_extension()])


###########################################
def convert(text, template, opts):
    """convert(str, str, argparse.Namespace) -> str

Converts the Markdown source `text' into a complete Beamer document.
"""
    meta, body = split_frontmatter(text)

    # -V overrides the metadata block before anything is derived from it, so
    # that '-V title=...' also reaches the short title in the footline.
    meta.update(opts.variable)

    markdown = make_markdown(opts, meta)
    ast = markdown.parse(body)
    if opts.dump_ast:
        for child in ast.children:
            print(child, file=sys.stderr)
    slides = markdown.render(ast)

    # After the body, so that the renderer's quote state belongs to the deck
    # and not to whatever the title happened to end with.
    render_metadata(markdown, meta)

    variables = build_variables(meta, slides)

    # -V can also set a template variable that is not metadata at all.  The
    # ones computed from a metadata flag are excluded: -V reached those
    # through the metadata above, and letting the raw string through as well
    # would put the word 'false' on a slide where the block should be empty.
    for key, value in opts.variable.items():
        if key not in FLAG_VARIABLES and key not in MARKDOWN_METADATA:
            # not the prose keys either: those reached the metadata above and
            # were rendered there, and putting the raw string back would make
            # '\title[rendered]{raw}' disagree with itself
            variables[key] = value

    return string.Template(template).safe_substitute(variables)


###########################################
def parse_args(argv=None):
    """parse_args([str]) -> argparse.Namespace"""
    parser = argparse.ArgumentParser(
                prog=PROG,
                description="Convert Markdown into LaTeX Beamer slides.")
    parser.add_argument("file", nargs="?", default='-', metavar='FILE',
                        help="input markdown file, '-' for stdin "
                             "(default: stdin)")
    parser.add_argument('-o', '--output', metavar='FILE', default='-',
                        help="output .tex file, '-' for stdout "
                             "(default: stdout)")
    parser.add_argument('-t', '--template', metavar='FILE',
                        help="Beamer template file (default: %s next to this "
                             "script, or $%s)"
                             % (DEFAULT_TEMPLATE, TEMPLATE_ENV_VAR))
    parser.add_argument('-V', '--variable', action='append', default=[],
                        metavar='KEY=VALUE',
                        help="set a template variable, overriding the "
                             "metadata block (repeatable)")
    parser.add_argument('-l', '--slide-level', type=int, default=1,
                        metavar='N',
                        help="heading level that starts a new frame "
                             "(default: %(default)s)")
    parser.add_argument('--escapechar', default=LISTINGS_ESCAPECHAR,
                        metavar='CHAR',
                        help="escape character inside ```lstlisting blocks, "
                             "empty to switch it off (default: %(default)s)")
    parser.add_argument('--handout', action='store_true',
                        help="one page per frame: silence \\pausex, as "
                             "'handout: true' in the metadata does")
    parser.add_argument('-p', '--pdf', action='store_true',
                        help="also run latexmk (or pdflatex) on the result; "
                             "without -o the name is taken from the input")
    parser.add_argument('--verbose-latex', action='store_true',
                        help="show the LaTeX engine's output instead of just "
                             "its errors")
    parser.add_argument('-d', '--dump-ast', action='store_true',
                        help="dump the parsed Markdown tree to stderr")
    parser.add_argument('--version', action='version',
                        version='%(prog)s ' + VERSION)

    args = parser.parse_args(argv)

    # -V key=value pairs are more useful as a dict
    variables = {}
    for item in args.variable:
        key, sep, value = item.partition('=')
        if not sep:
            parser.error("-V expects KEY=VALUE, got '%s'" % item)
        variables[key.strip()] = value

    # the flag is the same thing as the metadata key, and says so louder
    if args.handout:
        variables['handout'] = 'true'

    args.variable = variables

    # A PDF cannot be made out of stdout, so --pdf needs a real file to
    # write; take its name from the input when -o was not given.
    if args.pdf and args.output == '-':
        if args.file == '-':
            parser.error('--pdf needs -o FILE, or a named input file')
        args.output = os.path.splitext(args.file)[0] + '.tex'

    # Opening the output truncates it, and that happens before a byte of the
    # input is read -- so if the two are the same file the deck is destroyed
    # and the frames come out empty.  'mdslides --pdf deck.tex' is the way in:
    # splitext() hands back the name it was given.
    if args.file != '-' and args.output != '-' and same_file(args.file,
                                                             args.output):
        parser.error("the output file '%s' is the input file" % args.output)

    args.file = open_file(parser, args.file, 'r', sys.stdin, 'input file')
    # Kept, because the handle is a temporary file whose name is not the
    # document's; --pdf and finish_output() both need where it is going.
    args.output_path = None if args.output == '-' else args.output
    args.output = open_output(parser, args.output, sys.stdout)

    if args.template is None:
        args.template = open_file(parser, find_template(), 'r',
                                  what='default template')
    else:
        args.template = open_file(parser, args.template, 'r', what='template')

    return args


###########################################
if __name__ == '__main__':
    args = parse_args()

    try:
        args.output.write(convert(args.file.read(), args.template.read(),
                                  args))
    except BaseException:
        # Includes the sys.exit() a bad metadata block raises.  Nothing but
        # the temporary file has been written, so the target is untouched.
        discard_output(args)
        raise

    # This is also what flushes it to disk before LaTeX is handed the name.
    finish_output(args)

    if args.pdf:
        sys.exit(run_latex(args.output_path, quiet=not args.verbose_latex))
