# cases, so the fallbacks produce a plain but valid presentation.
TEMPLATE_DEFAULTS = {
    'theme': 'default',
    'colortheme': 'default',
    'fonttheme': 'default',
    # Latin Modern, as pandoc does. The template used to hard-code palatino,
    # but that only sets \rmfamily, which beamer never uses for slide text --
    # it left the body in Nimbus Sans and the maths in Computer Modern, two
    # families that do not belong together. lmodern covers both.
    'fontfamily': 'lmodern',
    'title': '',
    'subtitle': '',
    'author': '',
    'institute': '',
    'date': '',
    'headerincludes': '',
    'titlepage': '',
    'sectionpages': '',
    'toc': '',
    'handout': '',
}

# Template variables whose value is a block of LaTeX computed from a
# metadata flag rather than taken from it.  -V sets the flag, never the
# block: '-V toc=false' means no table of contents, not the word 'false'
