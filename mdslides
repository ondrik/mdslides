#!/usr/bin/env python3

"""Convert Markdown into LaTeX Beamer slides.

A lightweight alternative to `pandoc -t beamer', built on marko.  The guiding
principle is LaTeX passthrough: whatever the Markdown parser does not
recognize is handed over to LaTeX untouched, so a slide can always fall back
to raw LaTeX.

The Beamer preamble lives in an external template file (see --template).
"""

import argparse
import marko
import os
import re
import string
import sys
import yaml

PROG = 'mdslides'
VERSION = '0.1'

DEFAULT_TEMPLATE = 'beamer.tex.tpl'
TEMPLATE_ENV_VAR = 'MD_SLIDES_TEMPLATE'

# string.Template has no conditionals, so a variable the template mentions
# must always resolve to something: an unsubstituted '$theme' would reach
# LaTeX and be read as maths.  These are the values used when the metadata
# block says nothing.  'default' is a real Beamer theme name in all three
# cases, so the fallbacks produce a plain but valid presentation.
TEMPLATE_DEFAULTS = {
    'theme': 'default',
    'colortheme': 'default',
    'fonttheme': 'default',
    # what the template used to hard-code, so that a deck which says nothing
    # about fonts still looks the way it did
    'fontfamily': 'palatino',
    'title': '',
    'author': '',
    'institute': '',
    'date': '',
    'headerincludes': '',
}

# Metadata that is a list of people or places, rather than a block of text.
JOINED_WITH_AND = ('author', 'institute')

# Short forms for the footline; each falls back to its long form.
SHORT_FORMS = (('shorttitle', 'title'),
               ('shortauthor', 'author'),
               ('shortdate', 'date'),
               # beamer's footline is cramped, and the full affiliation
               # rarely fits, so this one defaults to empty instead
               ('shortinstitute', None))

# Characters that have to be escaped where LaTeX is not wanted, i.e. inside
# `inline code'.  Prose is passed through untouched; see BeamerRenderer.
LATEX_ESCAPES = {
    '\\': '\\textbackslash{}', '{': '\\{', '}': '\\}', '$': '\\$',
    '&': '\\&', '#': '\\#', '_': '\\_', '%': '\\%',
    '~': '\\~{}', '^': '\\^{}',
}

# '\_' in Markdown means a literal underscore, which LaTeX also spells '\_';
# '\*' on the other hand is just an asterisk.
LATEX_SPECIALS = set('#$%&_{}')

# Classes recognized in a frame's attribute list, '# Title {.fragile}'.
FRAME_OPTIONS = ('fragile', 'plain', 'allowframebreaks', 'shrink', 'squeeze',
                 'noframenumbering', 't', 'b', 'c')

# A trailing attribute list on a heading: '{.fragile}', '{label=intro}'.  The
# tokens have to look like attributes, so that a title ending in \hlbl{Foo}
# is not mistaken for one.
HEADING_ATTRS_RE = re.compile(
    r'\s*\{((?:\s*[.#][-\w]+|\s*[-\w]+=[^{}\s]+)+)\s*\}\s*$')

# Fence languages that the listings package knows.  It errors out on a
# language it cannot load, so anything missing here becomes a plain listing.
# A '[dialect]language' value has to reach LaTeX inside braces, and some
# languages (Lua) have dialects but no default, so naming one is mandatory.
# Every value below was checked by compiling it.
LISTINGS_LANGUAGES = {
    'c': 'C', 'c++': 'C++', 'cpp': 'C++', 'haskell': 'Haskell',
    'hs': 'Haskell', 'java': 'Java', 'python': 'Python', 'py': 'Python',
    'bash': 'bash', 'sh': 'sh', 'shell': 'sh', 'sql': 'SQL', 'tex': 'TeX',
    'latex': '[LaTeX]TeX', 'lua': '[5.3]Lua', 'perl': 'Perl', 'php': 'PHP',
    'ruby': 'Ruby', 'prolog': 'Prolog', 'lisp': 'Lisp', 'ml': 'ML',
    'caml': 'Caml', 'ocaml': '[Objective]Caml', 'r': 'R', 'matlab': 'Matlab',
    'xml': 'XML', 'html': 'HTML', 'make': 'make', 'makefile': 'make',
    'llvm': 'LLVM', 'verilog': 'Verilog', 'vhdl': 'VHDL',
    'fortran': 'Fortran', 'pascal': 'Pascal', 'ada': 'Ada',
}

# A YAML metadata block, fenced by '---' and closed by '---' or '...'.  Only
# recognized at the very start of the document, where CommonMark would
# otherwise see a thematic break.
FRONTMATTER_RE = re.compile(r"""\A---[ \t]*\r?\n              # opening fence
                                (.*?)                         # the YAML itself
                                ^(?:---|\.\.\.)[ \t]*\r?$\r?\n?  # closing fence
                             """, re.DOTALL | re.MULTILINE | re.VERBOSE)

# HTML comments are legal in Markdown but not in YAML, and they are a handy
# way to disable a metadata line, e.g. '<!--lang: en-->'.
YAML_COMMENT_RE = re.compile(r'^[ \t]*<!--.*?-->[ \t]*$\n?', re.MULTILINE)


###########################################
def find_template():
    """find_template() -> str

Returns the path to the default template: the one named by $MD_SLIDES_TEMPLATE
if set, otherwise the one shipped next to this script.
"""
    from_env = os.environ.get(TEMPLATE_ENV_VAR)
    if from_env:
        return from_env

    return os.path.join(os.path.dirname(os.path.realpath(__file__)),
                        DEFAULT_TEMPLATE)


###########################################
def open_file(parser, path, mode, standard=None, what='file'):
    """open_file(ArgumentParser, str, str, file, str) -> file

Opens `path' in `mode', or returns `standard' if the path is '-'.  Files are
UTF-8 regardless of the locale, since a deck is likely to contain accented
characters.  A path that cannot be opened is a usage error, reported through
`parser', which exits with status 2.
"""
    if path == '-' and standard is not None:
        # Make sure a piped deck is decoded as UTF-8 too.  Under pytest the
        # standard streams are replaced by objects without reconfigure().
        if hasattr(standard, 'reconfigure'):
            standard.reconfigure(encoding='utf-8')
        return standard

    try:
        return open(path, mode, encoding='utf-8')
    except OSError as exc:
        parser.error("cannot open the %s '%s': %s"
                     % (what, path, exc.strerror))


###########################################
def split_frontmatter(text):
    """split_frontmatter(str) -> (dict, str)

Splits the leading YAML metadata block off `text' and returns the parsed
metadata together with the remaining Markdown body.  A document without a
metadata block yields an empty dict and the text unchanged.

The block is replaced by as many blank lines as it occupied, so that line
numbers in the body still match the input file.
"""
    match = FRONTMATTER_RE.match(text)
    if not match:
        return {}, text

    try:
        meta = yaml.safe_load(YAML_COMMENT_RE.sub('', match.group(1)))
    except yaml.YAMLError as exc:
        sys.exit("%s: cannot parse the metadata block: %s" % (PROG, exc))

    if meta is None:            # an empty metadata block
        meta = {}
    if not isinstance(meta, dict):
        sys.exit("%s: the metadata block must be a mapping, got %s"
                 % (PROG, type(meta).__name__))

    return meta, '\n' * match.group(0).count('\n') + text[match.end():]


###########################################
def as_list(value):
    """as_list(object) -> list

Wraps a lone metadata value in a list, so that 'author: X' and a YAML list of
authors can be handled the same way.
"""
    if value is None or value == '':
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    return [value]


###########################################
def build_variables(meta, slides):
    """build_variables(dict, str) -> dict

Turns the document metadata into the substitution mapping for the template.

Every variable the shipped template mentions is guaranteed to be present, so
that no '$name' can leak into the LaTeX output.  Metadata keys are passed
through as they are, which lets a custom template use anything from the
metadata block.
"""
    variables = dict(TEMPLATE_DEFAULTS)

    for key, value in meta.items():
        if value is None:               # e.g. a bare 'logo:' with no value
            continue
        if key in JOINED_WITH_AND:
            value = ' \\and '.join(str(item) for item in as_list(value))
        elif isinstance(value, (list, tuple)):
            value = '\n'.join(str(item) for item in value)
        variables[key] = value
        if '-' in key:
            # string.Template only recognizes identifiers, so
            # 'header-includes' has to be reachable as '$headerincludes'
            variables[key.replace('-', '')] = value

    # Options for \documentclass, as one string: an empty one would leave a
    # stray comma behind, which LaTeX complains about.
    options = ['dvipsnames']
    if meta.get('fontsize'):
        options.append(str(meta['fontsize']))
    if meta.get('aspectratio'):
        options.append('aspectratio=%s' % meta['aspectratio'])
    options.extend(str(option) for option in as_list(meta.get('classoption')))
    variables['classoptions'] = ','.join(options)

    for short, long in SHORT_FORMS:
        if not variables.get(short):
            variables[short] = variables[long] if long else ''

    variables['slides'] = slides
    return variables


###########################################
def escape_latex(text):
    """escape_latex(str) -> str

Escapes the characters LaTeX treats specially.  Only used where the text is
meant to be taken literally, i.e. inside `inline code'.
"""
    return ''.join(LATEX_ESCAPES.get(char, char) for char in text)


###########################################
def heading_level(element):
    """heading_level(Element) -> int or None

The level of a heading element, or None if it is not a heading.
"""
    if element.get_type() in ('Heading', 'SetextHeading'):
        return element.level
    return None


###########################################
def split_heading_attributes(title):
    """split_heading_attributes(str) -> (str, [str])

Splits a trailing attribute list off a frame title, returning the title and
the frame options it asks for:

    'Algorithm {.fragile}'  ->  ('Algorithm', ['fragile'])
"""
    match = HEADING_ATTRS_RE.search(title)
    if not match:
        return title, []

    options = []
    for token in match.group(1).split():
        if token.startswith('.') and token[1:] in FRAME_OPTIONS:
            options.append(token[1:])
        elif '=' in token:
            options.append(token)
        elif token.startswith('#'):
            options.append('label=%s' % token[1:])

    return title[:match.start()].rstrip(), options


###########################################
def contains_verbatim(elements):
    """contains_verbatim([Element]) -> bool

Whether anything in the subtree is typeset verbatim.  Beamer needs
[fragile] on a frame that holds a listing, because it has to read the frame
body twice.
"""
    for element in elements:
        if element.get_type() in ('FencedCode', 'CodeBlock'):
            return True
        children = getattr(element, 'children', None)
        if children and not isinstance(children, str) \
                and contains_verbatim(children):
            return True
    return False


###########################################
class BeamerRenderer(marko.Renderer):
    """Renders a parsed Markdown document as the body of a Beamer document.

Prose is passed through to LaTeX untouched: whatever marko does not
recognize as Markdown is assumed to be LaTeX and left alone.  That is what
lets \\hlbl{...} and \\ldots work in the middle of a sentence.  Escaping only
happens inside `inline code', where the text is meant to be literal.
"""

    #: heading level that starts a new frame; set by make_markdown()
    slide_level = 1

    ####################
    # document structure
    ####################

    def render_document(self, element):
        parts = []
        for kind, heading, nodes in self.split_slides(element.children):
            if kind == 'section':
                title, _ = split_heading_attributes(self.render_children(heading))
                parts.append('\\section{%s}\n' % title)
            else:
                parts.append(self.render_frame(heading, nodes))
        return '\n'.join(parts)

    def split_slides(self, children):
        """split_slides([Element]) -> [(str, Element or None, [Element])]

Groups the top level of the document into sections and frames.  A heading
above the slide level becomes a \\section, one at the slide level starts a
frame, and a thematic break starts a frame with no title.
"""
        slides = []
        frame = None

        for child in children:
            level = heading_level(child)
            if level is not None and level < self.slide_level:
                slides.append(('section', child, []))
                frame = None
            elif level == self.slide_level:
                frame = []
                slides.append(('frame', child, frame))
            elif child.get_type() == 'ThematicBreak':
                frame = []
                slides.append(('frame', None, frame))
            elif frame is None:
                # material before the first heading: skip the blank lines
                # left behind by the metadata block, keep anything else
                if child.get_type() == 'BlankLine':
                    continue
                frame = [child]
                slides.append(('frame', None, frame))
            else:
                frame.append(child)

        return slides

    def render_frame(self, heading, nodes):
        """render_frame(Element or None, [Element]) -> str"""
        options = []
        title = ''
        if heading is not None:
            title, options = split_heading_attributes(
                self.render_children(heading))
        if contains_verbatim(nodes) and 'fragile' not in options:
            options.insert(0, 'fragile')

        head = '\\begin{frame}'
        if options:
            head += '[%s]' % ','.join(options)
        if title:
            head += '{%s}' % title

        body = ''.join(self.render(node) for node in nodes)
        return '%s\n%s\\end{frame}\n' % (head, body)

    ####################
    # blocks
    ####################

    def render_paragraph(self, element):
        text = self.render_children(element)
        return text + ('\n' if element._tight else '\n\n')

    def render_blank_line(self, element):
        return ''

    def render_line_break(self, element):
        return '\n' if element.soft else '\\\\\n'

    def render_list(self, element):
        environment = 'enumerate' if element.ordered else 'itemize'
        return '\\begin{%s}\n%s\\end{%s}\n' % (
            environment, self.render_children(element), environment)

    def render_list_item(self, element):
        body = self.render_children(element).lstrip()
        if not body.strip():
            return '\\item\n'
        return '\\item %s' % (body if body.endswith('\n') else body + '\n')

    def render_quote(self, element):
        return '\\begin{quote}\n%s\\end{quote}\n' % self.render_children(element)

    def render_fenced_code(self, element):
        return self.render_listing(element.lang, element.children[0].children)

    def render_code_block(self, element):
        return self.render_listing('', element.children[0].children)

    def render_listing(self, language, code):
        """render_listing(str, str) -> str"""
        options = []
        listings_name = LISTINGS_LANGUAGES.get(language.strip().lower())
        if listings_name:
            # braces: a '[dialect]language' value would otherwise break the
            # option parser of listings
            options.append('language={%s}' % listings_name)

        head = '\\begin{lstlisting}'
        if options:
            head += '[%s]' % ','.join(options)
        if not code.endswith('\n'):
            code += '\n'
        return '%s\n%s\\end{lstlisting}\n' % (head, code)

    def render_heading(self, element):
        # A heading below the slide level.  TODO: \begin{block}{...}, which
        # needs the following siblings, not just this element.
        title, _ = split_heading_attributes(self.render_children(element))
        return '\\textbf{%s}\\par\n' % title

    def render_setext_heading(self, element):
        return self.render_heading(element)

    def render_thematic_break(self, element):
        # only reached inside a container; at the top level it starts a frame
        return '\\medskip\\hrule\\medskip\n'

    def render_html_block(self, element):
        return ''       # commented-out slides and <!-- notes -->

    def render_link_ref_def(self, element):
        return ''

    ####################
    # inline
    ####################

    def render_raw_text(self, element):
        return element.children         # straight through to LaTeX

    def render_literal(self, element):
        char = element.children
        return '\\' + char if char in LATEX_SPECIALS else char

    def render_emphasis(self, element):
        return '\\emph{%s}' % self.render_children(element)

    def render_strong_emphasis(self, element):
        return '\\textbf{%s}' % self.render_children(element)

    def render_code_span(self, element):
        return '\\texttt{%s}' % escape_latex(element.children)

    def render_link(self, element):
        return '\\href{%s}{%s}' % (element.dest.replace('%', '\\%'),
                                   self.render_children(element))

    def render_auto_link(self, element):
        return '\\url{%s}' % element.dest.replace('%', '\\%')

    def render_image(self, element):
        return '\\includegraphics{%s}' % element.dest

    def render_inline_html(self, element):
        return ''


###########################################
def make_markdown(opts):
    """make_markdown(argparse.Namespace) -> marko.Markdown

marko instantiates the renderer itself, so the options it needs are handed
over as class attributes of a throwaway subclass.
"""
    renderer = type('_BeamerRenderer', (BeamerRenderer,),
                    {'slide_level': opts.slide_level})
    return marko.Markdown(renderer=renderer)


###########################################
def convert(text, template, opts):
    """convert(str, str, argparse.Namespace) -> str

Converts the Markdown source `text' into a complete Beamer document.
"""
    meta, body = split_frontmatter(text)

    # -V overrides the metadata block before anything is derived from it, so
    # that '-V title=...' also reaches the short title in the footline.
    meta.update(opts.variable)

    markdown = make_markdown(opts)
    ast = markdown.parse(body)
    if opts.dump_ast:
        for child in ast.children:
            print(child, file=sys.stderr)
    slides = markdown.render(ast)

    variables = build_variables(meta, slides)
    # -V can also set a template variable that is not metadata at all
    variables.update(opts.variable)

    return string.Template(template).safe_substitute(variables)


###########################################
def parse_args(argv=None):
    """parse_args([str]) -> argparse.Namespace"""
    parser = argparse.ArgumentParser(
                prog=PROG,
                description="Convert Markdown into LaTeX Beamer slides.")
    parser.add_argument("file", nargs="?", default='-', metavar='FILE',
                        help="input markdown file, '-' for stdin "
                             "(default: stdin)")
    parser.add_argument('-o', '--output', metavar='FILE', default='-',
                        help="output .tex file, '-' for stdout "
                             "(default: stdout)")
    parser.add_argument('-t', '--template', metavar='FILE',
                        help="Beamer template file (default: %s next to this "
                             "script, or $%s)"
                             % (DEFAULT_TEMPLATE, TEMPLATE_ENV_VAR))
    parser.add_argument('-V', '--variable', action='append', default=[],
                        metavar='KEY=VALUE',
                        help="set a template variable, overriding the "
                             "metadata block (repeatable)")
    parser.add_argument('-l', '--slide-level', type=int, default=1,
                        metavar='N',
                        help="heading level that starts a new frame "
                             "(default: %(default)s)")
    parser.add_argument('-d', '--dump-ast', action='store_true',
                        help="dump the parsed Markdown tree to stderr")
    parser.add_argument('--version', action='version',
                        version='%(prog)s ' + VERSION)

    args = parser.parse_args(argv)

    # -V key=value pairs are more useful as a dict
    variables = {}
    for item in args.variable:
        key, sep, value = item.partition('=')
        if not sep:
            parser.error("-V expects KEY=VALUE, got '%s'" % item)
        variables[key.strip()] = value
    args.variable = variables

    args.file = open_file(parser, args.file, 'r', sys.stdin, 'input file')
    args.output = open_file(parser, args.output, 'w', sys.stdout, 'output file')

    if args.template is None:
        args.template = open_file(parser, find_template(), 'r',
                                  what='default template')
    else:
        args.template = open_file(parser, args.template, 'r', what='template')

    return args


###########################################
if __name__ == '__main__':
    args = parse_args()

    args.output.write(convert(args.file.read(), args.template.read(), args))
